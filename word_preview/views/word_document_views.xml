<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="word_document_view_form" model="ir.ui.view">
        <field name="name">word.document.form</field>
        <field name="model">word.document</field>
        <field name="arch" type="xml">
            <form string="Document Word" class="o_word_editor_form">
                <header>
                    <button name="action_save_to_source" type="object"
                            string="Enregistrer dans le fichier Word"
                            class="btn-primary" icon="fa-floppy-o"
                            invisible="not attachment_id"/>
                    <button name="action_download_docx" type="object"
                            string="Télécharger .docx" icon="fa-download"/>
                    <button name="action_preview_source" type="object"
                            string="Aperçu du fichier" icon="fa-eye"
                            invisible="not attachment_id"/>
                    <button name="action_reload_from_source" type="object"
                            string="Recharger le fichier d'origine"
                            icon="fa-refresh" invisible="not attachment_id"
                            confirm="Les modifications non enregistrées dans le fichier Word seront perdues. Continuer ?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ex : Attestation.docx"/></h1>
                    </div>
                    <div class="text-muted small mb-2" invisible="not attachment_id">
                        <i class="fa fa-file-word-o me-1" title="Fichier"/>
                        <field name="attachment_id" readonly="1" class="d-inline"
                               options="{'no_open': True}"/>
                        <span invisible="not last_saved_date">
                            · enregistré le <field name="last_saved_date" class="d-inline"/>
                        </span>
                    </div>
                    <field name="body" widget="html" class="o_word_editor_body"
                           options="{'codeview': true, 'resizable': false}"
                           placeholder="Saisissez votre texte. Tapez / pour insérer un titre, un tableau, une image…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="word_document_view_list" model="ir.ui.view">
        <field name="name">word.document.list</field>
        <field name="model">word.document</field>
        <field name="arch" type="xml">
            <list string="Documents Word">
                <field name="name"/>
                <field name="attachment_id" optional="show"/>
                <field name="last_saved_date" optional="show"/>
                <field name="write_date" string="Modifié le"/>
                <field name="create_uid" string="Par" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="word_document_view_search" model="ir.ui.view">
        <field name="name">word.document.search</field>
        <field name="model">word.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="mine" string="Mes documents"
                        domain="[('create_uid', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_word_document" model="ir.actions.act_window">
        <field name="name">Documents Word</field>
        <field name="res_model">word.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez un document Word</p>
            <p>Ouvrez un fichier .docx avec « Modifier dans Odoo » (aperçu ou
                menu Action de Documents), ou créez un nouveau document ici.</p>
        </field>
    </record>

    <menuitem id="menu_word_document_root" name="Documents Word"
              action="action_word_document" sequence="60"
              web_icon="word_preview,static/description/icon.png"
              groups="base.group_user"/>
</odoo>
