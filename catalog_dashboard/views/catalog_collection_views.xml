<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ KANBAN : Tableau de bord des collections ============ -->
    <record id="catalog_collection_view_kanban" model="ir.ui.view">
        <field name="name">catalog.collection.kanban.dashboard</field>
        <field name="model">catalog.collection</field>
        <field name="arch" type="xml">
            <kanban class="o_catalog_dashboard_kanban" create="false">
                <field name="name"/>
                <field name="accent_color"/>
                <field name="product_count"/>
                <field name="total_stock"/>
                <field name="avg_cost"/>
                <field name="realise_count"/>
                <field name="en_cours_count"/>
                <field name="a_planifier_count"/>
                <field name="low_stock_count"/>
                <field name="favorite_count"/>
                <field name="cover_image_1920"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_catalog_collection_card oe_kanban_global_click"
                             t-attf-style="--cd-accent:#{record.accent_color.raw_value || '#8C5A34'}">
                            <div class="o_catalog_collection_cover">
                                <img t-if="record.cover_image_1920.raw_value"
                                     t-att-src="kanban_image('catalog.collection', 'cover_image_1920', record.id.raw_value)"
                                     alt="Photo collection"/>
                                <div t-else="" class="o_catalog_collection_cover_empty"/>
                                <div class="o_catalog_collection_cover_head">
                                    <span class="o_catalog_collection_eyebrow">Collection</span>
                                    <div class="o_catalog_collection_head">
                                        <span class="o_catalog_collection_dot"
                                              t-attf-style="background: #{record.accent_color.raw_value || '#8C5A34'}"/>
                                        <span class="o_catalog_collection_name">
                                            <field name="name"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_catalog_collection_cover_count">
                                    <field name="product_count"/> références produit
                                </div>
                                <div t-if="record.favorite_count.raw_value" class="o_catalog_collection_fav_badge">
                                    <i class="fa fa-heart"/> <field name="favorite_count"/>
                                </div>
                                <div t-if="record.low_stock_count.raw_value" class="o_catalog_collection_alert_badge">
                                    <i class="fa fa-exclamation-triangle"/> <field name="low_stock_count"/> stock faible
                                </div>
                            </div>
                            <div class="o_catalog_collection_body">
                                <div class="o_catalog_collection_stats">
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val"><field name="product_count"/></div>
                                        <div class="o_catalog_stat_lbl">Références produit</div>
                                    </div>
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val"><field name="total_stock"/></div>
                                        <div class="o_catalog_stat_lbl">Stock</div>
                                    </div>
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val">
                                            <field name="avg_cost" widget="float" options="{'digits': [12, 2]}"/>
                                        </div>
                                        <div class="o_catalog_stat_lbl">Coût prod. moyen</div>
                                    </div>
                                </div>
                                <div class="o_catalog_progress_wrap">
                                    <div class="o_catalog_progress_track">
                                        <t t-if="record.product_count.raw_value">
                                            <span t-if="record.realise_count.raw_value" class="o_catalog_progress_seg o_catalog_progress_ok"
                                                  t-attf-style="flex-grow:#{record.realise_count.raw_value}"/>
                                            <span t-if="record.en_cours_count.raw_value" class="o_catalog_progress_seg o_catalog_progress_warn"
                                                  t-attf-style="flex-grow:#{record.en_cours_count.raw_value}"/>
                                            <span t-if="record.a_planifier_count.raw_value" class="o_catalog_progress_seg o_catalog_progress_muted"
                                                  t-attf-style="flex-grow:#{record.a_planifier_count.raw_value}"/>
                                        </t>
                                        <span t-else="" class="o_catalog_progress_seg o_catalog_progress_empty" style="flex-grow:1"/>
                                    </div>
                                </div>
                                <div class="o_catalog_collection_progress" title="Avancement de la production (indépendant du stock)">
                                    <span class="o_catalog_legend_title">Production :</span>
                                    <span class="o_catalog_legend">
                                        <span class="o_catalog_legend_dot ok"/>
                                        <field name="realise_count"/> réalisée
                                    </span>
                                    <span class="o_catalog_legend">
                                        <span class="o_catalog_legend_dot warn"/>
                                    <field name="en_cours_count"/> en cours
                                    </span>
                                    <span class="o_catalog_legend">
                                        <span class="o_catalog_legend_dot muted"/>
                                        <field name="a_planifier_count"/> à planifier
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ LISTE ============ -->
    <record id="catalog_collection_view_list" model="ir.ui.view">
        <field name="name">catalog.collection.list</field>
        <field name="model">catalog.collection</field>
        <field name="arch" type="xml">
            <list string="Collections">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="product_count"/>
                <field name="total_stock"/>
                <field name="avg_cost" widget="float" options="{'digits': [12, 3]}"/>
                <field name="realise_count"/>
                <field name="en_cours_count"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="catalog_collection_view_form" model="ir.ui.view">
        <field name="name">catalog.collection.form</field>
        <field name="model">catalog.collection</field>
        <field name="arch" type="xml">
            <form string="Collection">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_products" icon="fa-list">
                            <field name="product_count" widget="statinfo" string="Références"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. MOKA"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="accent_color"/>
                            <field name="color" widget="color_picker" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="total_stock"/>
                            <field name="avg_cost"/>
                            <field name="realise_count"/>
                            <field name="en_cours_count"/>
                            <field name="a_planifier_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Références produit">
                            <field name="product_ids">
                                <list>
                                    <field name="sku"/>
                                    <field name="ref_nom"/>
                                    <field name="couleur_principale"/>
                                    <field name="stock"/>
                                    <field name="cout_production"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'realise'"
                                           decoration-warning="status == 'en_cours'"
                                           decoration-info="status == 'lancement2'"
                                           decoration-muted="status == 'a_planifier'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="catalog_collection_action" model="ir.actions.act_window">
        <field name="name">Tableau de bord — Collections</field>
        <field name="res_model">catalog.collection</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première collection de catalogue
            </p>
        </field>
    </record>

    <record id="catalog_collection_action_list" model="ir.actions.act_window">
        <field name="name">Collections</field>
        <field name="res_model">catalog.collection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première collection de catalogue
            </p>
        </field>
    </record>

</odoo>
