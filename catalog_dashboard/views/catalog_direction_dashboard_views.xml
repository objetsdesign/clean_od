<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Nombre de produits par étape -->
    <record id="catalog_product_action_by_stage" model="ir.actions.act_window">
        <field name="name">Produits par étape</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">pivot,list,kanban</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="context">{'search_default_group_dev_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune référence produit pour le moment</p>
        </field>
    </record>

    <!-- Produits en retard -->
    <record id="catalog_product_action_late" model="ir.actions.act_window">
        <field name="name">Produits en retard</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('is_late','=',True)]</field>
        <field name="context">{'search_default_group_dev_stage': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun produit en retard 🎉</p>
        </field>
    </record>

    <!-- Prototypes et BAT à valider -->
    <record id="catalog_product_action_to_validate" model="ir.actions.act_window">
        <field name="name">Prototypes / BAT à valider</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('to_validate','=',True)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun prototype ni BAT en attente de validation</p>
        </field>
    </record>

    <!-- Fiches techniques incomplètes -->
    <record id="catalog_product_action_fiche_incomplete" model="ir.actions.act_window">
        <field name="name">Fiches techniques incomplètes</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('fiche_technique_complete','=',False)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Toutes les fiches techniques sont complètes</p>
        </field>
    </record>

    <!-- Produits sans coût validé -->
    <record id="catalog_product_action_cout_non_valide" model="ir.actions.act_window">
        <field name="name">Produits sans coût validé</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('cout_valide','=',False)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tous les coûts sont validés</p>
        </field>
    </record>

    <!-- Productions en cours et dates prévues -->
    <record id="catalog_product_action_production_en_cours" model="ir.actions.act_window">
        <field name="name">Productions en cours</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('dev_stage','in',('production_planifiee','production_en_cours'))]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune production planifiée ou en cours</p>
        </field>
    </record>

    <!-- Écart entre coût cible et coût réel -->
    <record id="catalog_product_action_ecart_cout" model="ir.actions.act_window">
        <field name="name">Écarts de coût (cible vs réel)</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,pivot,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('cout_cible','&gt;',0)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun coût cible renseigné pour le moment</p>
        </field>
    </record>

    <!-- Produits prêts ou non pour Shopify et les marketplaces -->
    <record id="catalog_product_action_shopify" model="ir.actions.act_window">
        <field name="name">Préparation Shopify / marketplaces</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="context">{'search_default_group_shopify': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune référence produit pour le moment</p>
        </field>
    </record>

    <!-- Documents de conformité manquants -->
    <record id="catalog_product_action_doc_conformite" model="ir.actions.act_window">
        <field name="name">Documents de conformité manquants</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('doc_conformite_ok','=',False)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tous les documents de conformité sont complets</p>
        </field>
    </record>

    <!-- Produits non liés à une fiche Odoo (Ventes/Achats/Inventaire) -->
    <record id="catalog_product_action_no_product_tmpl" model="ir.actions.act_window">
        <field name="name">Références sans produit Odoo</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="domain">[('product_tmpl_id','=',False)]</field>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Toutes les références ont un produit Odoo lié 🎉</p>
        </field>
    </record>

    <!-- Stock disponible / réservé / prévisionnel -->
    <record id="catalog_product_view_list_stock" model="ir.ui.view">
        <field name="name">catalog.product.list.stock</field>
        <field name="model">catalog.product</field>
        <field name="arch" type="xml">
            <list string="Stock disponible, réservé et prévisionnel">
                <field name="collection_id"/>
                <field name="model_id"/>
                <field name="sku"/>
                <field name="stock" sum="Total disponible"/>
                <field name="stock_reserve" sum="Total réservé"/>
                <field name="stock_previsionnel" sum="Total prévisionnel"/>
                <field name="stock_status" widget="badge"
                       decoration-danger="stock_status == 'rupture'"
                       decoration-warning="stock_status == 'faible'"
                       decoration-success="stock_status == 'disponible'"/>
            </list>
        </field>
    </record>

    <record id="catalog_product_action_stock_detail" model="ir.actions.act_window">
        <field name="name">Stock disponible / réservé / prévisionnel</field>
        <field name="res_model">catalog.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="catalog_product_view_list_stock"/>
        <field name="search_view_id" ref="catalog_product_view_search"/>
        <field name="context">{'search_default_group_collection': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune référence produit pour le moment</p>
        </field>
    </record>

</odoo>
