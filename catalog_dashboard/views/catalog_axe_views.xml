<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="catalog_axe_view_kanban" model="ir.ui.view">
        <field name="name">catalog.axe.kanban</field>
        <field name="model">catalog.axe</field>
        <field name="arch" type="xml">
            <kanban class="o_catalog_dashboard_kanban" create="true">
                <field name="name"/>
                <field name="accent_color"/>
                <field name="brand_count"/>
                <field name="collection_count"/>
                <field name="product_count"/>
                <field name="late_count"/>
                <field name="low_stock_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_catalog_collection_card oe_kanban_global_click"
                             t-attf-style="--cd-accent:#{record.accent_color.raw_value || '#8C5A34'}">
                            <div class="o_catalog_collection_cover o_catalog_collection_cover_empty">
                                <div class="o_catalog_collection_cover_head">
                                    <span class="o_catalog_collection_eyebrow">Axe</span>
                                    <div class="o_catalog_collection_head">
                                        <span class="o_catalog_collection_dot"
                                              t-attf-style="background: #{record.accent_color.raw_value || '#8C5A34'}"/>
                                        <span class="o_catalog_collection_name">
                                            <field name="name"/>
                                        </span>
                                    </div>
                                </div>
                                <div t-if="record.late_count.raw_value" class="o_catalog_collection_alert_badge">
                                    <i class="fa fa-clock-o"/> <field name="late_count"/> en retard
                                </div>
                            </div>
                            <div class="o_catalog_collection_body">
                                <div class="o_catalog_collection_stats">
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val"><field name="brand_count"/></div>
                                        <div class="o_catalog_stat_lbl">Marques</div>
                                    </div>
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val"><field name="collection_count"/></div>
                                        <div class="o_catalog_stat_lbl">Collections</div>
                                    </div>
                                    <div class="o_catalog_stat">
                                        <div class="o_catalog_stat_val"><field name="product_count"/></div>
                                        <div class="o_catalog_stat_lbl">Références</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="catalog_axe_view_list" model="ir.ui.view">
        <field name="name">catalog.axe.list</field>
        <field name="model">catalog.axe</field>
        <field name="arch" type="xml">
            <list string="Axes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="brand_count"/>
                <field name="collection_count"/>
                <field name="product_count"/>
                <field name="late_count"/>
                <field name="low_stock_count"/>
            </list>
        </field>
    </record>

    <record id="catalog_axe_view_form" model="ir.ui.view">
        <field name="name">catalog.axe.form</field>
        <field name="model">catalog.axe</field>
        <field name="arch" type="xml">
            <form string="Axe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_brands" icon="fa-tags">
                            <field name="brand_count" widget="statinfo" string="Marques"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Luminaire"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="accent_color"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="collection_count"/>
                            <field name="product_count"/>
                            <field name="late_count"/>
                            <field name="low_stock_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="catalog_axe_action" model="ir.actions.act_window">
        <field name="name">Axes</field>
        <field name="res_model">catalog.axe</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier axe (ex. Luminaire, Bougie, Textile...)
            </p>
        </field>
    </record>

</odoo>
