<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="catalog_brand_view_list" model="ir.ui.view">
        <field name="name">catalog.brand.list</field>
        <field name="model">catalog.brand</field>
        <field name="arch" type="xml">
            <list string="Marques">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="axe_id"/>
                <field name="collection_count"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="catalog_brand_view_form" model="ir.ui.view">
        <field name="name">catalog.brand.form</field>
        <field name="model">catalog.brand</field>
        <field name="arch" type="xml">
            <form string="Marque">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_collections" icon="fa-folder-open">
                            <field name="collection_count" widget="statinfo" string="Collections"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Clérieu"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="axe_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="product_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="catalog_brand_action" model="ir.actions.act_window">
        <field name="name">Marques</field>
        <field name="res_model">catalog.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première marque (ex. Clérieu, Von Ros, Unit Lab...)
            </p>
        </field>
    </record>

</odoo>
