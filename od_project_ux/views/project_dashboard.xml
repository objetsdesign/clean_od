<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_project_ux_dashboard" model="ir.actions.client">
        <field name="name">Project Overview</field>
        <field name="tag">od_project_ux.dashboard</field>
    </record>

    <!-- The "Overview" menu entry has been removed; "Projets" (Portfolio)
