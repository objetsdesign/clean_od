<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="custom_newsletter_subscribe_form"
        inherit_id="website_mass_mailing.s_newsletter_subscribe_form"
        name="Custom Newsletter CRM Form">

        <xpath expr="//div[contains(@class, 's_newsletter_subscribe_form')]" position="replace">
            <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe"
                 data-source="Newsletter">

                <div class="js_subscribed_wrap d-none">
                    <p class="h4-fs text-center text-success">
                        <i class="fa fa-check-circle-o"/> Merci ! Votre email a été enregistré.
                    </p>
                </div>

                <div class="js_subscribe_wrap">
                    <div class="input-group">
                        <input type="email"
                               name="email"
                               class="js_subscribe_value form-control"
                               placeholder="johnsmith@example.com"
                               required="required"/>
                        <a role="button"
                           href="#"
                           class="btn btn-primary js_subscribe_btn">
                            Subscribe
                        </a>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>
