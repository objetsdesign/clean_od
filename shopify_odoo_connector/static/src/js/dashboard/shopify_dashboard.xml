<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="shopify_odoo_connector.ShopifyDashboard">
    <div class="o_shopify_dashboard">

        <!-- ===================== En-tête / filtres ===================== -->
        <div class="o_shopify_dashboard_header">
            <div class="o_shopify_dashboard_title">
                <i class="fa fa-shopping-bag o_shopify_dashboard_title_icon"/>
                <div>
                    <h1>Ventes Shopify</h1>
                    <span class="text-muted">
                        Performance commerciale en temps réel
                        <t t-if="state.data and state.data.last_sync">
                            · Dernière synchro commandes : <t t-esc="state.data.last_sync"/>
                        </t>
                    </span>
                </div>
            </div>
            <div class="o_shopify_dashboard_filters">
                <select class="form-select form-select-sm" t-on-change="onShopChange">
                    <option value="">Toutes les boutiques</option>
                    <t t-foreach="(state.data and state.data.shops) or []" t-as="shop" t-key="shop.id">
                        <option t-att-value="shop.id">
                            <t t-esc="shop.name"/>
                        </option>
                    </t>
                </select>
                <select class="form-select form-select-sm" t-on-change="onPeriodChange">
                    <t t-foreach="periodOptions" t-as="opt" t-key="opt.value">
                        <option t-att-value="opt.value" t-att-selected="opt.value === state.period">
                            <t t-esc="opt.label"/>
                        </option>
                    </t>
                </select>
                <button class="btn btn-sm o_shopify_refresh_btn" t-on-click="onRefresh" title="Actualiser">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </div>

        <!-- ===================== États ===================== -->
        <div t-if="state.loading" class="o_shopify_dashboard_loading">
            <i class="fa fa-circle-o-notch fa-spin"/> Chargement des statistiques…
        </div>

        <div t-elif="state.error" class="alert alert-danger m-3" role="alert">
            <t t-esc="state.error"/>
        </div>

        <div t-elif="state.data" class="o_shopify_dashboard_body">

            <!-- ===================== KPI ===================== -->
            <div class="o_shopify_kpi_row">
                <div class="o_shopify_kpi_card o_shopify_kpi_revenue">
                    <span class="o_shopify_kpi_label">Chiffre d'affaires</span>
                    <span class="o_shopify_kpi_value">
                        <t t-esc="formatMoney(state.data.kpis.revenue.value)"/>
                    </span>
                    <span t-attf-class="o_shopify_kpi_delta {{ deltaClass(state.data.kpis.revenue.delta) }}">
                        <t t-if="formatDelta(state.data.kpis.revenue.delta)">
                            <i t-attf-class="fa {{ deltaIcon(state.data.kpis.revenue.delta) }}"/>
                            <t t-esc="formatDelta(state.data.kpis.revenue.delta)"/>
                            <span class="text-muted"> vs période précédente</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-star"/> Nouveau
                            <span class="text-muted"> · pas de période précédente comparable</span>
                        </t>
                    </span>
                </div>

                <div class="o_shopify_kpi_card o_shopify_kpi_orders">
                    <span class="o_shopify_kpi_label">Commandes confirmées</span>
                    <span class="o_shopify_kpi_value">
                        <t t-esc="state.data.kpis.orders_count.value"/>
                    </span>
                    <span t-attf-class="o_shopify_kpi_delta {{ deltaClass(state.data.kpis.orders_count.delta) }}">
                        <t t-if="formatDelta(state.data.kpis.orders_count.delta)">
                            <i t-attf-class="fa {{ deltaIcon(state.data.kpis.orders_count.delta) }}"/>
                            <t t-esc="formatDelta(state.data.kpis.orders_count.delta)"/>
                            <span class="text-muted"> vs période précédente</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-star"/> Nouveau
                            <span class="text-muted"> · pas de période précédente comparable</span>
                        </t>
                    </span>
                    <span t-if="state.data.reconciliation" class="o_shopify_kpi_footnote">
                        <t t-esc="state.data.reconciliation.total_all_time"/> commandes au total
                        (tous statuts, toutes périodes) — voir le menu
                        <a href="#" class="o_shopify_reconciliation_link" t-on-click.prevent="onOpenShops">Boutiques</a>
                    </span>
                </div>

                <div class="o_shopify_kpi_card o_shopify_kpi_aov">
                    <span class="o_shopify_kpi_label">Panier moyen</span>
                    <span class="o_shopify_kpi_value">
                        <t t-esc="formatMoney(state.data.kpis.aov.value)"/>
                    </span>
                    <span t-attf-class="o_shopify_kpi_delta {{ deltaClass(state.data.kpis.aov.delta) }}">
                        <t t-if="formatDelta(state.data.kpis.aov.delta)">
                            <i t-attf-class="fa {{ deltaIcon(state.data.kpis.aov.delta) }}"/>
                            <t t-esc="formatDelta(state.data.kpis.aov.delta)"/>
                            <span class="text-muted"> vs période précédente</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-star"/> Nouveau
                            <span class="text-muted"> · pas de période précédente comparable</span>
                        </t>
                    </span>
                </div>

                <div class="o_shopify_kpi_card o_shopify_kpi_customers">
                    <span class="o_shopify_kpi_label">Clients acheteurs</span>
                    <span class="o_shopify_kpi_value">
                        <t t-esc="state.data.kpis.customers_count.value"/>
                    </span>
                    <span t-attf-class="o_shopify_kpi_delta {{ deltaClass(state.data.kpis.customers_count.delta) }}">
                        <t t-if="formatDelta(state.data.kpis.customers_count.delta)">
                            <i t-attf-class="fa {{ deltaIcon(state.data.kpis.customers_count.delta) }}"/>
                            <t t-esc="formatDelta(state.data.kpis.customers_count.delta)"/>
                            <span class="text-muted"> vs période précédente</span>
                        </t>
                        <t t-else="">
                            <i class="fa fa-star"/> Nouveau
                            <span class="text-muted"> · pas de période précédente comparable</span>
                        </t>
                    </span>
                </div>
            </div>


            <!-- ===================== Courbe principale ===================== -->
            <div class="o_shopify_panel o_shopify_panel_trend">
                <div class="o_shopify_panel_title">Évolution du chiffre d'affaires et des commandes</div>
                <div class="o_shopify_chart_wrap o_shopify_chart_trend">
                    <canvas t-ref="trendCanvas"/>
                </div>
            </div>

            <!-- ===================== Deuxième rangée ===================== -->
            <div class="o_shopify_row_2col">
                <div class="o_shopify_panel">
                    <div class="o_shopify_panel_title">Répartition du CA par boutique</div>
                    <div t-if="!state.data.revenue_by_shop.length" class="o_shopify_empty">
                        Aucune vente sur la période.
                    </div>
                    <div t-else="" class="o_shopify_chart_wrap o_shopify_chart_donut">
                        <canvas t-ref="shopCanvas"/>
                    </div>
                </div>

                <div class="o_shopify_panel">
                    <div class="o_shopify_panel_title">Top produits (par chiffre d'affaires)</div>
                    <div t-if="!state.data.top_products.length" class="o_shopify_empty">
                        Aucune vente sur la période.
                    </div>
                    <div t-else="" class="o_shopify_chart_wrap o_shopify_chart_products">
                        <canvas t-ref="productsCanvas"/>
                    </div>
                </div>
            </div>

            <!-- ===================== Commandes récentes ===================== -->
            <div class="o_shopify_panel">
                <div class="o_shopify_panel_title">Dernières commandes</div>
                <div t-if="!state.data.recent_orders.length" class="o_shopify_empty">
                    Aucune commande sur la période.
                </div>
                <table t-else="" class="o_shopify_orders_table">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th>Client</th>
                            <th>Boutique</th>
                            <th>Date</th>
                            <th>Statut paiement</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.recent_orders" t-as="order" t-key="order.id"
                            class="o_shopify_order_row" t-on-click="() => this.openOrder(order.id)">
                            <td><span class="o_shopify_order_name"><t t-esc="order.name"/></span></td>
                            <td><t t-esc="order.partner"/></td>
                            <td><t t-esc="order.shop"/></td>
                            <td><t t-esc="order.date"/></td>
                            <td>
                                <span t-if="order.financial_status" t-attf-class="badge o_shopify_status_badge o_shopify_status_{{ order.financial_status }}">
                                    <t t-esc="order.financial_status"/>
                                </span>
                            </td>
                            <td class="text-end"><t t-esc="formatMoney(order.amount_total)"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</t>

</templates>
