<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="shopify_odoo_connector.ShopifyStatusBar">
    <div class="o_shop_bar" t-if="state.items.length">
        <div class="o_shop_bar_title">
            <span class="o_shop_bar_icon"><i class="fa fa-shopping-bag"/></span>
            <div>
                <strong t-esc="title or 'Shopify'"/>
                <span><t t-esc="fmt(state.total)"/> enregistrement<t t-if="state.total > 1">s</t> · cliquez sur un statut pour filtrer</span>
            </div>
        </div>
        <div class="o_shop_bar_chips" role="group" aria-label="Filtrer par statut">
            <t t-foreach="state.items" t-as="item" t-key="item.value or 'none'">
                <button type="button"
                        t-attf-class="o_shop_chip o_shop_tone_{{ item.tone }} {{ isActive(item.value) ? 'active' : '' }}"
                        t-att-aria-pressed="isActive(item.value) ? 'true' : 'false'"
                        t-on-click="() => this.toggle(item)">
                    <span class="o_shop_dot"/>
                    <t t-esc="item.label"/>
                    <b t-esc="fmt(item.count)"/>
                </button>
            </t>
        </div>
    </div>
</t>

<!-- Ajout à TOUTES les listes (y compris celles qui héritent de web.ListView) :
     n'apparaît que si l'action demande la barre (contexte shopify_*). -->
<t t-inherit="web.ListView" t-inherit-mode="extension">
    <xpath expr="//t[@t-component='props.Renderer']" position="before">
        <t t-if="shopifyShowStatusBar">
            <t t-component="ShopifyStatusBar" resModel="props.resModel" fields="props.fields" context="props.context"/>
        </t>
    </xpath>
</t>

</templates>
