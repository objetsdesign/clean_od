<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="shopify_odoo_connector.ShopifyStatusDropdown">
    <div class="o_shop_status_dd" t-on-click.stop="">
        <Dropdown position="'bottom-start'" menuClass="'o_shop_status_menu'">
            <button type="button" t-attf-class="o_shop_status_btn o_shop_c_{{ colorOf(value) }}"
                    t-att-title="isAuto ? 'Statut automatique — cliquez pour le changer' : 'Statut choisi à la main — cliquez pour le changer'">
                <span class="o_shop_status_text" t-esc="label"/>
                <i t-if="isAuto" class="fa fa-magic o_shop_status_auto" title="Automatique"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="options" t-as="opt" t-key="opt[0]">
                    <DropdownItem onSelected="() => this.select(opt[0])"
                                  class="'o_shop_status_item' + (opt[0] === value ? ' active' : '')">
                        <span t-attf-class="o_shop_status_dot o_shop_c_{{ colorOf(opt[0]) }}"/>
                        <span t-esc="opt[1]"/>
                        <i t-if="opt[0] === value" class="fa fa-check ms-auto" title="Actuel"/>
                    </DropdownItem>
                </t>
                <t t-if="props.autoField">
                    <div class="dropdown-divider"/>
                    <DropdownItem onSelected="() => this.backToAuto()" class="'o_shop_status_item'">
                        <i class="fa fa-magic o_shop_status_dot_icon" title="Automatique"/>
                        <span>Automatique (calculé)</span>
                        <i t-if="isAuto" class="fa fa-check ms-auto" title="Actuel"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </div>
</t>

</templates>
