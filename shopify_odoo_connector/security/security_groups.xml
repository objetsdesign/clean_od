<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shopify" model="ir.module.category">
        <field name="name">Connecteur Shopify</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_shopify_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_shopify"/>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_shopify"/>
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Correctif : jusqu'ici seul base.user_admin recevait group_shopify_user,
         donc tout autre utilisateur interne (y compris un admin custom ou le
         Super Administrateur base.user_root) se voyait refuser l'accès au
         dashboard ("Accès non autorisé.") sans que ce soit visible dans
         l'interface. On accorde group_shopify_user à tous les utilisateurs
         internes automatiquement, comme le fait Odoo pour ses propres
         fonctionnalités de base. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_shopify_user'))]"/>
    </record>
</odoo>
