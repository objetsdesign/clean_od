<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_report_wizard_form" model="ir.ui.view">
        <field name="name">shopify.report.wizard.form</field>
        <field name="model">shopify.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport Shopify" create="0" edit="0">
                <field name="kind" invisible="1"/>
                <div class="alert alert-success mb-3" role="status" invisible="kind != 'success'">Opération terminée.</div>
                <div class="alert alert-warning mb-3" role="status" invisible="kind != 'warning'">Des points demandent votre attention (voir ci-dessous).</div>
                <div class="alert alert-danger mb-3" role="status" invisible="kind != 'danger'">Des erreurs ont été détectées (voir ci-dessous).</div>
                <field name="body_html" nolabel="1" readonly="1" class="o_shopify_report_body"/>
                <footer>
                    <button string="Fermer" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
