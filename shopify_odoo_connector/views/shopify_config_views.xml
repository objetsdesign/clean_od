<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Fiche boutique (v9.7) : en-tête allégé (3 actions principales),
         les autres actions sont rangées par thème dans l'onglet « Actions »
         sous forme de cartes explicites (icône + titre + explication).
         ===================================================================== -->
    <record id="view_shopify_config_form" model="ir.ui.view">
        <field name="name">shopify.config.form</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <form class="o_shopify_config_form">
                <header>
                    <button name="action_connect_private" type="object" string="Connecter la boutique"
                            class="btn-primary"
                            invisible="auth_type != 'private' or state == 'connected'"/>
                    <button name="action_connect_oauth" type="object" string="Connecter avec Shopify"
                            class="btn-primary"
                            invisible="auth_type != 'oauth' or state == 'connected'"/>
                    <button name="action_sync_all_now" type="object" string="Tout synchroniser"
                            class="btn-primary" icon="fa-refresh"
                            invisible="state != 'connected'"/>
                    <button name="action_sync_diagnostic" type="object" string="Diagnostic"
                            icon="fa-stethoscope" invisible="state != 'connected'"/>
                    <button name="action_test_connection" type="object" string="Tester la connexion"
                            icon="fa-plug" invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="state != 'connected'">
                        <button name="action_view_shopify_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Produits"/>
                        </button>
                        <button name="action_view_shopify_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="customer_count" widget="statinfo" string="Clients"/>
                        </button>
                        <button name="action_view_shopify_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Commandes"/>
                        </button>
                        <button name="action_view_sync_errors" type="object" class="oe_stat_button text-danger"
                                icon="fa-exclamation-triangle" invisible="sync_error_count == 0">
                            <field name="sync_error_count" widget="statinfo" string="Erreurs (7j)"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-secondary" invisible="active"/>

                    <div class="o_shopify_hero">
                        <div class="o_shopify_hero_logo"><i title="Shopify" class="fa fa-shopping-bag"/></div>
                        <div class="o_shopify_hero_text">
                            <h1 class="mb-0"><field name="name" placeholder="Ma boutique Shopify"/></h1>
                            <div class="o_shopify_hero_url">
                                <i title="Domaine" class="fa fa-globe me-1"/>
                                <field name="shop_url" placeholder="monshop.myshopify.com" class="o_shopify_inline_field"/>
                                <span class="o_shopify_version ms-2" title="Version du connecteur installée">Connecteur v9.7</span>
                            </div>
                        </div>
                        <div class="o_shopify_hero_status">
                            <span class="o_shopify_pill o_shopify_pill_ok" invisible="state != 'connected'">
                                <i title="Statut" class="fa fa-circle"/> Connectée
                            </span>
                            <span class="o_shopify_pill o_shopify_pill_draft" invisible="state != 'draft'">
                                <i title="Statut" class="fa fa-circle-o"/> Non connectée
                            </span>
                            <span class="o_shopify_pill o_shopify_pill_error" invisible="state != 'error'">
                                <i title="Erreur" class="fa fa-exclamation-circle"/> Erreur de connexion
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert" invisible="not last_error">
                        <i title="Erreurs" class="fa fa-exclamation-triangle mt-1"/>
                        <div><strong>Dernière erreur</strong><br/><field name="last_error" nolabel="1"/></div>
                    </div>

                    <!-- Bandeau « dernières synchros » -->
                    <div class="o_shopify_sync_strip" invisible="state != 'connected'">
                        <div class="o_shopify_sync_strip_item">
                            <i title="Produits" class="fa fa-cubes"/>
                            <div><span>Produits</span><field name="last_sync_products" invisible="not last_sync_products"/><b invisible="last_sync_products">jamais</b></div>
                        </div>
                        <div class="o_shopify_sync_strip_item">
                            <i title="Commandes" class="fa fa-shopping-cart"/>
                            <div><span>Commandes</span><field name="last_sync_orders" invisible="not last_sync_orders"/><b invisible="last_sync_orders">jamais</b></div>
                        </div>
                        <div class="o_shopify_sync_strip_item">
                            <i title="Clients" class="fa fa-users"/>
                            <div><span>Clients</span><field name="last_sync_customers" invisible="not last_sync_customers"/><b invisible="last_sync_customers">jamais</b></div>
                        </div>
                        <div class="o_shopify_sync_strip_item">
                            <i title="Webhooks" class="fa fa-bolt"/>
                            <div><span>Webhooks en attente</span><field name="webhook_pending_count"/></div>
                        </div>
                    </div>

                    <notebook>
                        <!-- ============ Synchronisation ============ -->
                        <page string="Synchronisation" name="sync">
                            <div class="o_shopify_settings_grid">
                                <div class="o_shopify_settings_card">
                                    <div class="o_shopify_settings_card_title"><i title="Produits" class="fa fa-cubes"/> Catalogue</div>
                                    <group>
                                        <field name="sync_products" widget="boolean_toggle" string="Produits"/>
                                        <field name="sync_categories" widget="boolean_toggle" string="Catégories"/>
                                        <field name="sync_inventory" widget="boolean_toggle" string="Stock"/>
                                        <field name="share_catalog" widget="boolean_toggle" string="Catalogue partagé"/>
                                        <field name="export_brand_filter" placeholder="ex : CLERIEU"/>
                                        <field name="export_brand_exclude" placeholder="aucune exclusion"/>
                                    </group>
                                </div>
                                <div class="o_shopify_settings_card">
                                    <div class="o_shopify_settings_card_title"><i title="Commandes" class="fa fa-shopping-cart"/> Ventes</div>
                                    <group>
                                        <field name="sync_orders" widget="boolean_toggle" string="Commandes"/>
                                        <field name="sync_payments" widget="boolean_toggle" string="Paiements"/>
                                        <field name="sync_fulfillments" widget="boolean_toggle" string="Expéditions"/>
                                        <field name="sync_customers" widget="boolean_toggle" string="Clients"/>
                                        <field name="share_customers" widget="boolean_toggle" string="Clients partagés"/>
                                        <field name="auto_confirm_orders" invisible="1"/>
                                    </group>
                                </div>
                                <div class="o_shopify_settings_card o_shopify_settings_card_accent">
                                    <div class="o_shopify_settings_card_title"><i title="Suppression" class="fa fa-trash-o"/> Suppression des produits</div>
                                    <p class="text-muted small mb-2">
                                        Garde les deux catalogues identiques : un produit supprimé
                                        d'un côté disparaît aussi de l'autre.
                                    </p>
                                    <group>
                                        <field name="product_delete_from_shopify" widget="radio"/>
                                        <field name="product_delete_to_shopify" widget="boolean_toggle"
                                               string="Supprimé dans Odoo → supprimer dans Shopify"/>
                                    </group>
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-3" invisible="state != 'connected'">
                                        <button name="action_check_deleted_now" type="object" class="btn btn-secondary btn-sm"
                                                icon="fa-search" string="Vérifier maintenant + diagnostic"/>
                                        <span class="text-muted small">
                                            Vérification automatique chaque minute · dernière :
                                            <field name="shopify_deleted_checked_at" class="d-inline" invisible="not shopify_deleted_checked_at"/>
                                            <span invisible="shopify_deleted_checked_at">jamais</span>
                                        </span>
                                    </div>
                                    <div class="o_shopify_hint" invisible="product_delete_from_shopify != 'delete'">
                                        <i title="Info" class="fa fa-info-circle"/>
                                        <span>Un produit déjà utilisé dans des commandes, factures ou
                                        mouvements de stock est <b>archivé</b> au lieu d'être supprimé,
                                        pour ne pas perdre l'historique.</span>
                                    </div>
                                </div>
                                <div class="o_shopify_settings_card">
                                    <div class="o_shopify_settings_card_title"><i title="Paramètres" class="fa fa-sliders"/> Valeurs par défaut</div>
                                    <group>
                                        <field name="default_warehouse_id"/>
                                        <field name="order_team_id"/>
                                        <field name="default_pricelist_id"/>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <!-- ============ Actions ============ -->
                        <page string="Actions" name="actions" invisible="state != 'connected'">
                            <div class="o_shopify_action_section">
                                <h5><i title="Import" class="fa fa-cloud-download"/> Importer depuis Shopify</h5>
                                <div class="o_shopify_action_grid">
                                    <button name="action_sync_products_now" type="object" class="o_shopify_action_card">
                                        <i title="Produits" class="fa fa-cubes"/><span class="o_title">Produits</span>
                                        <span class="o_desc">Produits, variantes et photos</span>
                                    </button>
                                    <button name="action_sync_orders_now" type="object" class="o_shopify_action_card">
                                        <i title="Commandes" class="fa fa-shopping-cart"/><span class="o_title">Commandes</span>
                                        <span class="o_desc">Nouvelles commandes et mises à jour</span>
                                    </button>
                                    <button name="action_sync_customers_now" type="object" class="o_shopify_action_card">
                                        <i title="Clients" class="fa fa-users"/><span class="o_title">Clients</span>
                                        <span class="o_desc">Contacts et adresses</span>
                                    </button>
                                    <button name="action_sync_inventory_now" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-archive"/><span class="o_title">Stock</span>
                                        <span class="o_desc">Quantités par emplacement</span>
                                    </button>
                                    <button name="action_sync_categories_now" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-sitemap"/><span class="o_title">Catégories</span>
                                        <span class="o_desc">Rattrape la catégorie des produits importés</span>
                                    </button>
                                </div>
                            </div>
                            <div class="o_shopify_action_section">
                                <h5><i title="Envoi" class="fa fa-cloud-upload"/> Envoyer vers Shopify</h5>
                                <div class="o_shopify_action_grid">
                                    <button name="action_push_inventory_now" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-upload"/><span class="o_title">Stock</span>
                                        <span class="o_desc">Envoie le stock Odoo actuel</span>
                                    </button>
                                    <button name="action_shopify_confirm_quotations" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-check-square-o"/><span class="o_title">Confirmer les devis</span>
                                        <span class="o_desc">Passe en commande les devis Shopify restés en attente</span>
                                    </button>
                                    <button name="action_shopify_apply_fiches_now" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-exchange"/><span class="o_title">Appliquer les fiches</span>
                                        <span class="o_desc">Applique la « Fiche active » choisie dans Shopify</span>
                                    </button>
                                </div>
                            </div>
                            <div class="o_shopify_action_section">
                                <h5><i title="Maintenance" class="fa fa-wrench"/> Maintenance</h5>
                                <div class="o_shopify_action_grid">
                                    <button name="action_resync_webhooks" type="object" class="o_shopify_action_card">
                                        <i title="Webhooks" class="fa fa-bolt"/><span class="o_title">Réinscrire les webhooks</span>
                                        <span class="o_desc">À faire si l'adresse d'Odoo a changé</span>
                                    </button>
                                    <button name="action_resync_locations" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-map-marker"/><span class="o_title">Emplacements</span>
                                        <span class="o_desc">Relit les emplacements Shopify</span>
                                    </button>
                                    <button name="action_check_scopes" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-key"/><span class="o_title">Autorisations</span>
                                        <span class="o_desc">Vérifie les accès accordés à l'app</span>
                                    </button>
                                    <button name="action_load_taxonomy" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-tags"/><span class="o_title">Catégories Shopify</span>
                                        <span class="o_desc">Charge la taxonomie standard</span>
                                    </button>
                                    <button name="action_shopify_create_fiche_definitions" type="object" class="o_shopify_action_card">
                                        <i title="Icône" class="fa fa-list-alt"/><span class="o_title">Métachamps Amazon</span>
                                        <span class="o_desc">Crée les champs détaillés « Amazon – … »</span>
                                    </button>
                                    <button name="action_connect_oauth" type="object" class="o_shopify_action_card"
                                            invisible="auth_type != 'oauth'">
                                        <i title="Synchroniser" class="fa fa-refresh"/><span class="o_title">Réautoriser</span>
                                        <span class="o_desc">Accorde les nouvelles autorisations OAuth</span>
                                    </button>
                                </div>
                            </div>
                        </page>

                        <!-- ============ Connexion ============ -->
                        <page string="Connexion" name="connection">
                            <div class="alert alert-info d-flex gap-2" role="alert" invisible="auth_type != 'private'">
                                <i title="Conseil" class="fa fa-lightbulb-o mt-1"/>
                                <div>
                                    Mode recommandé pour une seule boutique : créez une <b>app personnalisée</b>
                                    dans Shopify (Apps &gt; Développer des applications), activez les autorisations
                                    nécessaires, puis collez le <b>token d'accès Admin API</b> ci-dessous.
                                </div>
                            </div>
                            <group>
                                <group string="Méthode">
                                    <field name="auth_type" widget="radio"/>
                                    <field name="api_version"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                                <group string="Identifiants">
                                    <field name="access_token" password="True" invisible="auth_type != 'private'"/>
                                    <field name="client_id" invisible="auth_type != 'oauth'"/>
                                    <field name="client_secret" password="True"
                                           help="Client Secret de l'app : sert à vérifier la signature des webhooks reçus (et à l'OAuth)."/>
                                    <field name="scope" invisible="auth_type != 'oauth'"/>
                                </group>
                            </group>
                            <group string="Marketplaces (Etsy / Amazon)">
                                <field name="etsy_collection_title"/>
                                <field name="etsy_collection_id" invisible="not etsy_collection_id"/>
                                <field name="shopify_pin_detailed_metafields" widget="boolean_toggle"/>
                            </group>
                        </page>

                        <page string="Emplacements" name="locations">
                            <field name="location_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="shopify_location_id"/>
                                    <field name="warehouse_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Activité" name="activity">
                            <field name="sync_log_ids">
                                <list decoration-danger="state == 'error'" decoration-muted="state == 'success'" limit="40">
                                    <field name="create_date" string="Date"/>
                                    <field name="direction" widget="badge"/>
                                    <field name="shopify_object_type" string="Objet"/>
                                    <field name="message"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                                    <field name="model_name" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Webhooks" name="webhooks">
                            <field name="webhook_log_ids" context="{'default_config_id': id}">
                                <list limit="40">
                                    <field name="create_date" string="Reçu le"/>
                                    <field name="topic"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'processed'"
                                           decoration-warning="state == 'received'"
                                           decoration-danger="state == 'error'"/>
                                    <field name="processing_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         Boutiques — vue LISTE (v9.7) : nom + domaine, statut, santé,
         compteurs alignés, dernières synchros, actions en bout de ligne.
         ===================================================================== -->
    <record id="view_shopify_config_list" model="ir.ui.view">
        <field name="name">shopify.config.list</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <list class="o_shopify_shop_list" js_class="shopify_shop_list" decoration-muted="not active">
                <field name="active" column_invisible="1"/>
                <field name="name" string="Boutique" class="o_shop_col_name"/>
                <field name="shop_url" string="Domaine" class="text-muted" optional="hide"/>
                <field name="sync_health" string="Santé" widget="badge" width="150px"
                       decoration-success="sync_health == 'ok'"
                       decoration-warning="sync_health == 'risk'"
                       decoration-danger="sync_health == 'off'"/>
                <field name="state" string="Connexion" widget="badge" width="120px"
                       decoration-info="state == 'connected'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'draft'"/>
                <field name="sync_success_rate" string="Réussite des synchros (7 j)" widget="progressbar"
                       class="o_shop_col_rate"
                       decoration-danger="sync_success_rate &lt; 70"
                       decoration-warning="sync_success_rate &gt;= 70 and sync_success_rate &lt; 95"
                       decoration-success="sync_success_rate &gt;= 95"/>
                <field name="sync_error_label" string="Erreurs 7 j" widget="badge" width="120px"
                       decoration-danger="sync_error_count &gt; 0"
                       decoration-success="sync_error_count == 0"/>
                <field name="sync_error_count" column_invisible="1"/>
                <field name="product_count" string="Produits" class="text-end" width="80px"/>
                <field name="customer_count" string="Clients" class="text-end" width="80px" optional="hide"/>
                <field name="order_count" string="Commandes" class="text-end" width="100px"/>
                <field name="webhook_pending_count" string="En attente" class="text-end" optional="hide"/>
                <field name="last_sync_products_ago" string="Synchro produits" widget="badge" width="140px"
                       class="o_shop_col_time" optional="show"/>
                <field name="last_sync_orders_ago" string="Synchro commandes" widget="badge" width="150px"
                       class="o_shop_col_time" optional="hide"/>
                <field name="deleted_checked_ago" string="Suppressions" widget="badge" width="130px"
                       class="o_shop_col_time" optional="hide"/>
                <field name="last_sync_products" string="Date synchro produits" widget="datetime" optional="hide"/>
                <button name="action_view_sync_errors" type="object" icon="fa-exclamation-triangle"
                        title="Voir les erreurs" class="btn-link o_shop_btn_err" invisible="sync_error_count == 0"/>
                <button name="action_sync_all_now" type="object" icon="fa-refresh"
                        title="Synchroniser" class="btn-link o_shop_btn_sync" invisible="state != 'connected'"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_config_search" model="ir.ui.view">
        <field name="name">shopify.config.search</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Boutique"/>
                <field name="shop_url" string="Domaine"/>
                <filter name="health_off" string="Hors piste" domain="[('sync_health', '=', 'off')]"/>
                <filter name="health_risk" string="À risque" domain="[('sync_health', '=', 'risk')]"/>
                <filter name="health_ok" string="Sur la bonne voie" domain="[('sync_health', '=', 'ok')]"/>
                <separator/>
                <filter name="connected" string="Connectées" domain="[('state', '=', 'connected')]"/>
                <filter name="not_connected" string="Non connectées" domain="[('state', '!=', 'connected')]"/>
                <separator/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="Statut" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =====================================================================
         Boutiques — vue KANBAN (v9.7) : grande carte lisible par boutique.
         ===================================================================== -->
    <record id="view_shopify_config_kanban" model="ir.ui.view">
        <field name="name">shopify.config.kanban.dashboard</field>
        <field name="model">shopify.config</field>
        <field name="arch" type="xml">
            <kanban class="o_shopify_shop_kanban" js_class="shopify_shop_kanban" create="1" quick_create="0">
                <field name="id"/>
                <field name="name"/>
                <field name="shop_url"/>
                <field name="state"/>
                <field name="product_count"/>
                <field name="customer_count"/>
                <field name="order_count"/>
                <field name="sync_error_count"/>
                <field name="webhook_pending_count"/>
                <field name="last_sync_products"/>
                <field name="last_sync_orders"/>
                <field name="shopify_deleted_checked_at"/>
                <field name="last_sync_products_ago"/>
                <field name="last_sync_orders_ago"/>
                <field name="deleted_checked_ago"/>
                <field name="sync_health"/>
                <field name="sync_success_rate"/>
                <templates>
                    <t t-name="card" class="o_shopify_shop_card p-0">
                        <t t-set="connected" t-value="record.state.raw_value == 'connected'"/>
                        <t t-set="errors" t-value="record.sync_error_count.raw_value or 0"/>

                        <!-- En-tête coloré selon la santé -->
                        <div t-attf-class="o_shopify_shop_card_head is-#{record.sync_health.raw_value}">
                            <div t-attf-class="o_shopify_shop_avatar #{connected ? '' : 'is-off'}">
                                <t t-esc="(record.name.value or '?').replace('Boutique ', '').slice(0, 1).toUpperCase()"/>
                            </div>
                            <div class="o_shopify_shop_ident">
                                <span class="o_shopify_shop_name" t-att-title="record.name.value" t-esc="record.name.value"/>
                                <span class="o_shopify_shop_url">
                                    <i class="fa fa-globe me-1" title="Domaine"/><t t-esc="record.shop_url.value"/>
                                </span>
                            </div>
                            <span class="o_shop_head_health">
                                <i class="fa fa-circle" title="Santé"/> <t t-esc="record.sync_health.value"/>
                            </span>
                        </div>

                        <!-- Santé -->
                        <a t-if="errors" name="action_view_sync_errors" type="object" class="o_shopify_health is-bad">
                            <i class="fa fa-exclamation-triangle" title="Erreurs"/>
                            <span><b t-esc="errors"/> erreur<t t-if="errors &gt; 1">s</t> de synchro sur 7 jours</span>
                            <span class="o_shopify_health_cta">Voir <i class="fa fa-angle-right" title="Voir"/></span>
                        </a>
                        <div t-elif="connected" class="o_shopify_health is-good">
                            <i class="fa fa-check-circle" title="OK"/>
                            <span>Synchronisation sans erreur</span>
                        </div>
                        <div t-else="" class="o_shopify_health is-off">
                            <i class="fa fa-plug" title="Non connectée"/>
                            <span>Boutique non connectée — ouvrez-la pour la connecter</span>
                        </div>

                        <!-- Compteurs -->
                        <div class="o_shopify_shop_stats">
                            <a name="action_view_shopify_products" type="object" class="o_shopify_shop_stat">
                                <i class="fa fa-cubes" title="Produits"/>
                                <b t-esc="record.product_count.value"/><span>Produits</span>
                            </a>
                            <a name="action_view_shopify_customers" type="object" class="o_shopify_shop_stat">
                                <i class="fa fa-users" title="Clients"/>
                                <b t-esc="record.customer_count.value"/><span>Clients</span>
                            </a>
                            <a name="action_view_shopify_orders" type="object" class="o_shopify_shop_stat">
                                <i class="fa fa-shopping-cart" title="Commandes"/>
                                <b t-esc="record.order_count.value"/><span>Commandes</span>
                            </a>
                        </div>

                        <!-- Réussite des synchros -->
                        <div t-if="connected" t-attf-class="o_shop_rate #{record.sync_success_rate.raw_value &lt; 70 ? 'is-bad' : (record.sync_success_rate.raw_value &lt; 95 ? 'is-mid' : 'is-good')}">
                            <div class="o_shop_rate_label">
                                <span>Réussite des synchros (7 j)</span>
                                <b><t t-esc="record.sync_success_rate.raw_value"/> %</b>
                            </div>
                            <div class="o_shop_rate_track"><span t-attf-style="width: #{record.sync_success_rate.raw_value}%"/></div>
                        </div>

                        <!-- Dernières synchros -->
                        <ul class="o_shopify_shop_sync">
                            <li>
                                <span>Produits</span>
                                <b t-att-title="record.last_sync_products.value"
                                   t-attf-class="#{record.last_sync_products.raw_value ? '' : 'text-muted'}"
                                   t-esc="record.last_sync_products_ago.value"/>
                            </li>
                            <li>
                                <span>Commandes</span>
                                <b t-att-title="record.last_sync_orders.value"
                                   t-attf-class="#{record.last_sync_orders.raw_value ? '' : 'text-muted'}"
                                   t-esc="record.last_sync_orders_ago.value"/>
                            </li>
                            <li>
                                <span>Suppressions vérifiées</span>
                                <b t-att-title="record.shopify_deleted_checked_at.value"
                                   t-attf-class="#{record.shopify_deleted_checked_at.raw_value ? '' : 'text-muted'}"
                                   t-esc="record.deleted_checked_ago.value"/>
                            </li>
                            <li t-if="record.webhook_pending_count.raw_value">
                                <span>Notifications en attente</span>
                                <b class="text-warning" t-esc="record.webhook_pending_count.value"/>
                            </li>
                        </ul>

                        <!-- Actions -->
                        <div class="o_shopify_shop_foot">
                            <button name="action_check_deleted_now" type="object" class="btn btn-light btn-sm"
                                    invisible="state != 'connected'" title="Vérifier les suppressions + diagnostic">
                                <i class="fa fa-stethoscope me-1" title="Diagnostic"/>Diagnostic
                            </button>
                            <button name="action_sync_all_now" type="object" class="btn btn-primary btn-sm"
                                    invisible="state != 'connected'">
                                <i class="fa fa-refresh me-1" title="Synchroniser"/>Synchroniser
                            </button>
                            <a t-if="!connected" type="open" role="button" class="btn btn-primary btn-sm">
                                <i class="fa fa-plug me-1" title="Connecter"/>Connecter
                            </a>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
