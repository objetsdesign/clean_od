<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_shopify" model="ir.ui.view">
        <field name="name">product.template.form.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Shopify">
                    <field name="shopify_display"/>
                    <field name="shopify_vendor" string="Marque"/>
                    <field name="shopify_last_sync" readonly="1" invisible="not shopify_link_ids"/>
                </group>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_shopify_push" type="object" string="Envoyer vers Shopify"
                        icon="fa-refresh" invisible="not shopify_link_ids"
                        help="Force l'envoi immédiat vers Shopify (nom, prix, marque et photos : image principale, galerie et photos de variantes)."/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Shopify" name="shopify_links">
                    <group string="Contenu par marketplace (Amazon, Etsy, ... jusqu'à 40)">
                        <p class="text-muted" colspan="2">
                            Le produit et sa fiche Odoo restent UNIQUES.
                            Ajoutez une ligne par marketplace concernée
                            (liste gérée dans Shopify &gt; Configuration
                            &gt; Marketplaces) pour lui donner un
                            titre/une description propres, envoyés vers
                            Shopify en métachamp lors de l'export. Ligne
                            absente ou champ vide = nom/description
                            génériques du produit utilisés pour cette
                            marketplace.
                        </p>
                        <field name="shopify_marketplace_content_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="marketplace_id"/>
                                <field name="title_override" placeholder="Vide = nom du produit"/>
                                <field name="category_override"/>
                                <field name="effective_price" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="image_override" widget="image" class="oe_avatar" options="{'size': [40, 40]}"/>
                            </list>
                            <form string="Contenu par marketplace">
                                <field name="marketplace_platform_type" invisible="1"/>
                                <field name="product_tmpl_id" invisible="1"/>
                                <div class="d-flex justify-content-between align-items-start">
                                    <group>
                                        <field name="marketplace_id"/>
                                    </group>
                                    <button name="action_reset_to_product" type="object"
                                            string="Réinitialiser (suivre le produit)"
                                            class="btn-link"
                                            confirm="Vider le titre, la catégorie, la description, le prix, le stock, l'image et la galerie spécifiques à cette marketplace ? Elle suivra alors automatiquement le produit standard."
                                            help="Vide toutes les surcharges de cette ligne pour repartir des données standard du produit."/>
                                </div>
                                <notebook>
                                    <page string="Général" name="general">
                                        <group>
                                            <group string="Contenu">
                                                <field name="title_override" placeholder="Vide = nom du produit"/>
                                                <field name="effective_title" readonly="1" invisible="title_override"
                                                       string="Titre envoyé"/>
                                                <field name="category_override"
                                                       placeholder="Ex : chemin de catégorie / ID taxonomie propre à cette marketplace"/>
                                            </group>
                                            <group string="Prix &amp; stock">
                                                <field name="price_override" widget="monetary" options="{'currency_field': 'company_currency_id'}" placeholder="Vide = prix de vente du produit"/>
                                                <field name="company_currency_id" invisible="1"/>
                                                <field name="effective_price" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                                <field name="stock_override" placeholder="Vide = suit le stock Odoo"/>
                                                <field name="effective_stock" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Description">
                                            <field name="description_override" nolabel="1" colspan="2" widget="text"
                                                   placeholder="Vide = description du produit"/>
                                            <p class="text-muted mb-1" colspan="2" invisible="description_override">
                                                Aucune description spécifique : la description actuelle du produit sera envoyée automatiquement (mise à jour toute seule si vous la modifiez sur la fiche produit) —
                                            </p>
                                            <field name="effective_description" nolabel="1" colspan="2" readonly="1"
                                                   invisible="description_override"
                                                   class="text-muted"/>
                                        </group>
                                    </page>
                                    <page string="Médias" name="media">
                                        <group string="Image principale">
                                            <field name="image_override" widget="image" class="oe_avatar" nolabel="1"/>
                                            <p class="text-muted" colspan="2" invisible="image_override">
                                                Vide ci-dessus : c'est cette image du produit qui sera envoyée automatiquement —
                                            </p>
                                            <field name="effective_image" widget="image" class="oe_avatar" nolabel="1"
                                                   readonly="1" invisible="image_override"/>
                                        </group>
                                        <group string="Galerie complémentaire">
                                            <field name="media_ids" nolabel="1" colspan="2">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="image" widget="image" class="oe_avatar" options="{'size': [64, 64]}"/>
                                                    <field name="name"/>
                                                </list>
                                            </field>
                                        </group>
                                        <group string="Galerie produit (référence)" invisible="media_ids">
                                            <p class="text-muted mb-1" colspan="2">
                                                Aucune photo spécifique ci-dessus : ce sont ces photos du produit qui seront envoyées automatiquement pour cette marketplace —
                                            </p>
                                            <field name="product_gallery_image_ids" nolabel="1" colspan="2" readonly="1">
                                                <list create="0" delete="0" edit="0">
                                                    <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [64, 64]}"/>
                                                    <field name="name"/>
                                                </list>
                                            </field>
                                        </group>
                                    </page>
                                    <page string="Variantes" name="variants">
                                        <div class="mb-2">
                                            <button name="action_sync_variants" type="object"
                                                    string="Synchroniser les variantes"
                                                    class="btn-secondary"
                                                    help="Ajoute une ligne pour chaque variante du produit qui n'en a pas encore (ne touche pas aux lignes déjà personnalisées)."/>
                                        </div>
                                        <field name="variant_ids" nolabel="1" colspan="2">
                                            <list editable="bottom">
                                                <field name="product_id"/>
                                                <field name="title_override" placeholder="Vide = nom de la variante"/>
                                                <field name="effective_title" readonly="1" string="Titre envoyé"/>
                                                <field name="sku_override" placeholder="Vide = référence interne"/>
                                                <field name="effective_sku" readonly="1" string="SKU envoyé"/>
                                                <field name="price_override" widget="monetary" options="{'currency_field': 'currency_id'}" placeholder="Vide = prix de la variante"/>
                                                <field name="effective_price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" string="Prix envoyé"/>
                                                <field name="currency_id" column_invisible="1"/>
                                                <field name="stock_override" placeholder="Vide = stock Odoo"/>
                                                <field name="effective_stock" readonly="1" string="Stock envoyé"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Amazon" name="amazon"
                                          invisible="marketplace_platform_type != 'amazon'">
                                        <group>
                                            <group string="Fiche produit">
                                                <field name="amazon_brand" placeholder="Vide = marque du produit"/>
                                                <field name="amazon_gtin"/>
                                                <field name="amazon_browse_node_id"/>
                                                <field name="amazon_product_type"/>
                                                <field name="amazon_condition_type"/>
                                                <field name="amazon_country_of_origin"/>
                                            </group>
                                            <group string="Référencement">
                                                <field name="amazon_search_terms"/>
                                            </group>
                                        </group>
                                        <group string="Points clés">
                                            <field name="amazon_bullet_points" nolabel="1" colspan="2" placeholder="Un point clé par ligne (5 maximum)"/>
                                        </group>
                                        <group string="Réglementaire">
                                            <field name="amazon_safety_warning" nolabel="1" colspan="2"/>
                                        </group>
                                    </page>
                                    <page string="Etsy" name="etsy"
                                          invisible="marketplace_platform_type != 'etsy'">
                                        <group>
                                            <group string="Fabrication">
                                                <field name="etsy_who_made"/>
                                                <field name="etsy_when_made"/>
                                                <field name="etsy_is_supply"/>
                                            </group>
                                            <group string="Matières &amp; style">
                                                <field name="etsy_materials" placeholder="Ex : bois, coton, laiton"/>
                                                <field name="etsy_style_tags" placeholder="Séparés par des virgules, 13 max"/>
                                            </group>
                                        </group>
                                        <group string="Partenaires de production">
                                            <field name="etsy_production_partners" nolabel="1" colspan="2"/>
                                        </group>
                                        <group string="Personnalisation">
                                            <field name="etsy_personalization_instructions" nolabel="1" colspan="2"/>
                                        </group>
                                    </page>
                                    <page string="TikTok Shop" name="tiktok"
                                          invisible="marketplace_platform_type != 'tiktok'">
                                        <group>
                                            <group string="Catégorie">
                                                <field name="tiktok_category_id"/>
                                                <field name="tiktok_video_url"/>
                                            </group>
                                            <group string="Colis">
                                                <field name="tiktok_package_weight_kg"/>
                                                <field name="tiktok_package_length_cm"/>
                                                <field name="tiktok_package_width_cm"/>
                                                <field name="tiktok_package_height_cm"/>
                                            </group>
                                        </group>
                                        <group string="Conformité">
                                            <field name="tiktok_certifications" nolabel="1" colspan="2"/>
                                        </group>
                                    </page>
                                </notebook>
                            </form>
                        </field>
                    </group>
                    <field name="shopify_link_ids">
                        <list editable="bottom">
                            <field name="config_id"/>
                            <field name="shopify_title_override"
                                   string="Titre pour cette boutique"
                                   placeholder="Vide = nom du produit"/>
                            <field name="shopify_product_id" readonly="1"/>
                            <field name="shopify_handle" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                        </list>
                        <form>
                            <group>
                                <field name="config_id"/>
                                <field name="shopify_title_override"
                                       placeholder="Vide = nom du produit"/>
                                <field name="shopify_description_override"
                                       placeholder="Vide = description du produit"/>
                                <field name="shopify_product_id" readonly="1"/>
                                <field name="shopify_handle" readonly="1"/>
                                <field name="last_sync" readonly="1"/>
                            </group>
                        </form>
                    </field>
                    <p class="text-muted">
                        Pour relier ce produit à une boutique Shopify
                        supplémentaire, ajoutez une ligne ci-dessus en
                        choisissant uniquement la boutique : le produit
                        sera automatiquement créé côté Shopify lors de
                        l'enregistrement.
                    </p>
                    <p class="text-muted">
                        <strong>Un seul produit, un texte par boutique :</strong>
                        la fiche produit Odoo (nom, description) reste
                        unique et n'est jamais dupliquée. Pour envoyer un
                        titre/une description différents à Amazon, Etsy ou
                        toute autre boutique liée, ouvrez la ligne
                        correspondante ci-dessus (icône ou double-clic) et
                        renseignez "Titre pour cette boutique" /
                        "Description spécifique à cette boutique". Si ces
                        champs sont laissés vides, le nom et la description
                        de la fiche produit sont utilisés par défaut pour
                        cette boutique.
                    </p>
                    <p class="text-muted">
                        Les photos (image principale, galerie et photos par
                        variante) sont envoyées vers Shopify automatiquement
                        dès que vous les modifiez et enregistrez la fiche.
                        Utilisez le bouton "Envoyer vers Shopify" en haut de
                        la fiche pour forcer un renvoi immédiat.
                    </p>
                    <p class="text-muted">
                        Pour qu'une photo n'apparaisse que sur UNE variante
                        précise (plutôt que sur toutes) : ouvrez cette
                        variante (bouton "Variantes" en haut de la fiche, ou
                        menu Ventes &gt; Variantes de produit), onglet
                        "Ventes", section "Photos propres à CETTE variante
                        uniquement" (sous la galerie "Média Ecommerce"
                        habituelle, qui elle reste partagée). Ces photos
                        sont envoyées vers Shopify attachées uniquement à
                        cette variante.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list_shopify" model="ir.ui.view">
        <field name="name">product.template.list.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="shopify_display" string="Afficher sur Shopify" optional="show"/>
                <field name="shopify_vendor" string="Marque" optional="show"/>
                <field name="shopify_config_ids" string="Boutiques" optional="show" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_shopify" model="ir.ui.view">
        <field name="name">product.template.search.shopify</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="shopify_vendor" string="Marque Shopify"/>
                <field name="shopify_config_ids" string="Boutique Shopify"/>
                <separator/>
                <filter name="filter_shopify_linked" string="Produits Shopify"
                        domain="[('shopify_link_ids', '!=', False)]"/>
                <group string="Regrouper par" expand="0">
                    <filter name="group_by_shopify_vendor" string="Marque"
                            context="{'group_by': 'shopify_vendor'}"/>
                    <filter name="group_by_shopify_config" string="Boutique Shopify"
                            context="{'group_by': 'shopify_config_ids'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_products" model="ir.actions.act_window">
        <field name="name">Produits Shopify</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_product_template_search_shopify"/>
        <field name="domain">[('shopify_link_ids', '!=', False)]</field>
        <field name="context">{'search_default_group_by_shopify_vendor': 1, 'search_default_group_by_shopify_config': 1}</field>
    </record>

    <!-- ================= Variantes de produit ================= -->
    <!-- Même principe que le menu "Variantes de produit" du module Ventes,
         mais limité aux variantes des produits liés à au moins une boutique
         Shopify, pour rester dans le périmètre de ce module. -->
    <record id="view_product_product_search_shopify" model="ir.ui.view">
        <field name="name">product.product.search.shopify</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="product_tmpl_id" string="Produit"/>
                <separator/>
                <group string="Regrouper par" expand="0">
                    <filter name="group_by_shopify_config_variant" string="Boutique Shopify"
                            context="{'group_by': 'shopify_config_ids'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_product_variants" model="ir.actions.act_window">
        <field name="name">Variantes de produit</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_product_product_search_shopify"/>
        <field name="domain">[('product_tmpl_id.shopify_link_ids', '!=', False)]</field>
    </record>

    <!-- ============================================================
         DÉSACTIVÉ TEMPORAIREMENT (01/09/2026) :
         Cette vue héritait de product.product_normal_form_view (la fiche
         variante complète standard d'Odoo). Sur ce serveur, cette vue de
         base contient déjà, ailleurs dans son en-tête, un bouton qui
         pointe vers une action ("action_view_catalog_products") invalide
         pour le modèle product.product. Odoo revalide l'ARBRE COMPLET de
         la vue dès qu'un module y ajoute une surcharge : ce bug
         pré-existant (indépendant de ce connecteur) empêchait donc
         l'installation/mise à niveau du module entier.

         Cette section ajoutait uniquement un confort d'affichage (les
         photos propres à une variante, visibles directement dans sa
         fiche complète). Cette fonctionnalité reste disponible via le
         popup rapide "Variantes" natif d'Odoo (product_variant_easy_edit_view),
         qui n'est pas affecté par ce problème — voir le commentaire
         d'origine ci-dessous.

         Une fois le bug d'action corrigé côté serveur (cf. diagnostic :
         Réglages > Technique > Actions, ou mise à niveau des apps
         Ventes/Achats/Stock), ce bloc peut être réactivé en le
         décommentant, sans aucune autre modification nécessaire.

    <record id="view_product_product_form_shopify_variant_media" model="ir.ui.view">
        <field name="name">product.product.form.shopify.variant.media</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']" position="inside">
                <group colspan="2" name="shopify_variant_media"
                       string="Photos propres à CETTE variante uniquement">
                    <field colspan="2" name="product_variant_image_ids"
                           class="o_website_sale_image_list"
                           context="{'default_name': name}" mode="kanban"
                           add-label="Ajouter un média" nolabel="1"
                           widget="x2_many_media_viewer"
                           options="{'convert_to_webp': True}"/>
                </group>
            </xpath>
        </field>
    </record>
    ============================================================ -->
</odoo>
