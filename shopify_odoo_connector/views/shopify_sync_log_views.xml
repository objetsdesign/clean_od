<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sync_log_list" model="ir.ui.view">
        <field name="name">shopify.sync.log.list</field>
        <field name="model">shopify.sync.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Date" width="150px"/>
                <field name="config_id" string="Boutique" width="140px"/>
                <field name="state" string="Statut" widget="badge" width="110px"
                       decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="direction" string="Sens" widget="badge" width="150px"
                       decoration-info="direction == 'in'" decoration-primary="direction == 'out'"/>
                <field name="shopify_object_type" string="Objet" width="130px"/>
                <field name="message"/>
                <field name="model_name" optional="hide"/>
                <field name="shopify_object_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_shopify_sync_log" model="ir.actions.act_window">
        <field name="name">Journal de synchronisation</field>
        <field name="res_model">shopify.sync.log</field>
        <field name="context">{'shopify_list': 1, 'shopify_list_title': 'Journal de synchronisation', 'shopify_status_field': 'state'}</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
