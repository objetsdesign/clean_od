<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_shopify" model="ir.ui.view">
        <field name="name">res.partner.form.shopify</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Shopify" invisible="not shopify_partner_link_ids">
                    <field name="shopify_last_sync" readonly="1"/>
                </group>
                <group string="Boutiques Shopify liées">
                    <field name="shopify_partner_link_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="config_id"/>
                            <field name="shopify_customer_id" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
