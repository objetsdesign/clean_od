<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etsy_config_form" model="ir.ui.view">
        <field name="name">etsy.config.form</field>
        <field name="model">etsy.config</field>
        <field name="arch" type="xml">
            <form string="Connexion Etsy">
                <header>
                    <button name="action_connect_oauth" type="object" string="Connecter Etsy"
                            class="oe_highlight" invisible="state == 'connected'"/>
                    <button name="action_connect_oauth" type="object" string="Reconnecter Etsy"
                            invisible="state != 'connected'"/>
                    <button name="action_fetch_shop_info" type="object" string="Vérifier la boutique"
                            invisible="state != 'connected'"/>
                    <button name="action_fetch_shipping_profiles" type="object"
                            string="Voir mes profils d'expédition" invisible="state != 'connected'"/>
                    <button name="action_fetch_taxonomy" type="object" string="Voir les catégories Etsy"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        1) Créez une app développeur sur
                        <a href="https://www.etsy.com/developers/register" target="_blank">etsy.com/developers</a>
                        pour obtenir le Keystring. 2) Renseignez-le ci-dessous avec l'ID de votre
                        boutique Etsy. 3) Cliquez sur "Connecter Etsy". 4) Une fois connecté, utilisez
                        les boutons "Voir mes profils d'expédition" / "Voir les catégories Etsy" (résultat
                        dans le fil de discussion en bas de cette fiche) pour trouver les IDs à
                        renseigner dans les réglages par défaut.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Identifiants">
                            <field name="name"/>
                            <field name="client_id"/>
                            <field name="shop_id"/>
                        </group>
                        <group string="Réglages par défaut des annonces">
                            <field name="default_who_made"/>
                            <field name="default_when_made"/>
                            <field name="default_taxonomy_id"/>
                            <field name="default_shipping_profile_id"/>
                            <field name="is_supply"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_etsy_config_list" model="ir.ui.view">
        <field name="name">etsy.config.list</field>
        <field name="model">etsy.config</field>
        <field name="arch" type="xml">
            <list string="Connexions Etsy">
                <field name="name"/>
                <field name="shop_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_etsy_config" model="ir.actions.act_window">
        <field name="name">Connexion Etsy (API directe)</field>
        <field name="res_model">etsy.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_etsy_config" name="Connexion Etsy (API directe)"
              parent="menu_shopify_config_advanced" action="action_etsy_config" sequence="120"/>

</odoo>
