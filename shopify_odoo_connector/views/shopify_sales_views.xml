<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Devis ================= -->
    <record id="action_shopify_quotations" model="ir.actions.act_window">
        <field name="name">Devis Shopify</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_config_id', '!=', False), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'search_default_groupby_shopify_config': 1, 'shopify_list': 1, 'shopify_list_title': 'Devis', 'shopify_status_field': 'shopify_status'}</field>
    </record>

    <!-- ================= Devis à risque =================
         Heuristique : devis envoyés dont le statut financier Shopify
         indique un paiement non finalisé (en attente / autorisé / impayé). -->
    <record id="action_shopify_risky_quotations" model="ir.actions.act_window">
        <field name="name">Devis à risque</field>
        <field name="res_model">sale.order</field>
        <field name="context">{'shopify_list': 1, 'shopify_list_title': 'Devis à risque', 'shopify_status_field': 'shopify_status'}</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_config_id', '!=', False),
                               ('state', 'in', ('draft', 'sent')),
                               ('shopify_financial_status', 'in', ('pending', 'authorized', 'unpaid'))]</field>
    </record>

    <!-- ================= Commandes ================= -->
    <record id="action_shopify_orders" model="ir.actions.act_window">
        <field name="name">Commandes Shopify</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shopify_config_id', '!=', False), ('state', '=', 'sale')]</field>
        <field name="context">{'search_default_groupby_shopify_config': 1, 'shopify_list': 1, 'shopify_list_title': 'Commandes', 'shopify_status_field': 'shopify_status'}</field>
    </record>

    <!-- ================= Bons de livraison ================= -->
    <record id="view_stock_picking_list_shopify" model="ir.ui.view">
        <field name="name">stock.picking.list.shopify</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="shopify_fulfillment_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="shopify_status" string="Statut" widget="shopify_status_dropdown" width="150px"
                       options="{'auto_field': 'shopify_status_is_auto', 'auto_action': 'action_shopify_status_auto'}"
                       column_invisible="not context.get('shopify_list')"/>
                <field name="shopify_status_is_auto" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_shopify_delivery_orders" model="ir.actions.act_window">
        <field name="name">Bons de livraison Shopify</field>
        <field name="res_model">stock.picking</field>
        <field name="context">{'shopify_list': 1, 'shopify_list_title': 'Bons de livraison', 'shopify_status_field': 'shopify_status'}</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_id.shopify_config_id', '!=', False)]</field>
    </record>

    <!-- ================= Factures ================= -->
    <record id="action_shopify_invoices" model="ir.actions.act_window">
        <field name="name">Factures Shopify</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'),
                               ('invoice_line_ids.sale_line_ids.order_id.shopify_config_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'shopify_list': 1, 'shopify_list_title': 'Factures', 'shopify_status_field': 'shopify_status'}</field>
    </record>

    <!-- ================= Avoirs ================= -->
    <record id="action_shopify_refunds" model="ir.actions.act_window">
        <field name="name">Avoirs Shopify</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_refund'),
                               ('invoice_line_ids.sale_line_ids.order_id.shopify_config_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_refund', 'shopify_list': 1, 'shopify_list_title': 'Avoirs', 'shopify_status_field': 'shopify_status'}</field>
    </record>

    <!-- ================= Clients ================= -->
    <record id="action_shopify_customers" model="ir.actions.act_window">
        <field name="name">Clients Shopify</field>
        <field name="res_model">res.partner</field>
        <field name="context">{'shopify_list': 1, 'shopify_list_title': 'Clients', 'shopify_status_field': 'shopify_status'}</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('shopify_partner_link_ids', '!=', False)]</field>
    </record>

    <!-- ================= Statut (v9.7) sur les listes standard =================
         Colonne visible uniquement quand la liste est ouverte depuis un menu
         Shopify (contexte shopify_list). -->
    <record id="view_invoice_list_shopify_status" model="ir.ui.view">
        <field name="name">account.move.list.shopify.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="shopify_status" string="Statut" widget="shopify_status_dropdown" width="150px"
                       options="{'auto_field': 'shopify_status_is_auto', 'auto_action': 'action_shopify_status_auto'}"
                       column_invisible="not context.get('shopify_list')"/>
                <field name="shopify_status_is_auto" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_shopify_status" model="ir.ui.view">
        <field name="name">res.partner.list.shopify.status</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="shopify_status" string="Statut" widget="shopify_status_dropdown" width="150px"
                       options="{'auto_field': 'shopify_status_is_auto', 'auto_action': 'action_shopify_status_auto'}"
                       column_invisible="not context.get('shopify_list')"/>
                <field name="shopify_status_is_auto" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_variant_list_shopify_status" model="ir.ui.view">
        <field name="name">product.product.list.shopify.status</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="shopify_status" string="Statut" widget="shopify_status_dropdown" width="150px"
                       options="{'auto_field': 'shopify_status_is_auto', 'auto_action': 'action_shopify_status_auto'}"
                       column_invisible="not context.get('shopify_list')"/>
                <field name="shopify_status_is_auto" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
