<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_marketplace_list" model="ir.ui.view">
        <field name="name">shopify.marketplace.list</field>
        <field name="model">shopify.marketplace</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="platform_type"/>
                <field name="shopify_publish_mode"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_marketplace_form" model="ir.ui.view">
        <field name="name">shopify.marketplace.form</field>
        <field name="model">shopify.marketplace</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_shopify_push_products" type="object"
                            string="Renvoyer les produits vers Shopify"
                            class="btn-secondary"
                            confirm="Renvoyer vers Shopify tous les produits ayant une ligne pour cette marketplace ?"
                            help="À utiliser après un changement de mode : crée ou supprime les produits Shopify dédiés."/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"
                               placeholder="Généré automatiquement si vide"/>
                        <field name="platform_type"/>
                        <field name="active"/>
                    </group>
                    <group string="Publication vers Shopify">
                        <field name="shopify_publish_mode" widget="radio"/>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="shopify_publish_mode != 'etsy_api'">
                        <strong>Un seul produit Shopify.</strong> Le produit Shopify
                        garde le contenu Amazon. Odoo met à jour directement
                        l'annonce Etsy (titre, description, tags, matériaux, prix)
                        avec la ligne « Etsy » de chaque produit.
                        <br/>Dans OrderBridge &gt; Product Push, ne cochez plus
                        <strong>Title, Description, Tags ni Price</strong>
                        (ils écraseraient le contenu Etsy par celui d'Amazon) :
                        gardez Images, Quantity et SKU.
                    </div>
                    <group string="Connexion API Etsy"
                           invisible="shopify_publish_mode != 'etsy_api'">
                        <group>
                            <field name="etsy_keystring" password="True"/>
                            <field name="etsy_shared_secret" password="True"/>
                            <field name="etsy_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                        <group>
                            <field name="etsy_connected"/>
                            <field name="etsy_shop_id" readonly="1"/>
                            <field name="etsy_sync_price"/>
                            <field name="etsy_price_rate" invisible="not etsy_sync_price"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mb-3" invisible="shopify_publish_mode != 'etsy_api'">
                        <button name="action_etsy_connect" type="object" string="Connecter Etsy"
                                class="btn-primary" icon="fa-plug"/>
                        <button name="action_etsy_test" type="object" string="Tester la connexion"
                                class="btn-secondary" invisible="not etsy_connected"/>
                        <button name="action_etsy_disconnect" type="object" string="Déconnecter"
                                class="btn-link" invisible="not etsy_connected"
                                confirm="Déconnecter Etsy ? Les annonces Etsy ne seront plus mises à jour depuis Odoo."/>
                    </div>
                    <group string="Produit Shopify dédié"
                           invisible="shopify_publish_mode != 'dedicated'">
                        <field name="shopify_product_type" placeholder="Ex : Etsy"/>
                        <field name="shopify_sku_suffix" placeholder="Ex : -ETSY"/>
                        <field name="shopify_hide_from_online_store"/>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="shopify_publish_mode != 'dedicated'">
                        Chaque produit ayant une ligne pour cette marketplace
                        obtient un <strong>produit Shopify séparé</strong>
                        (titre, description, photos, prix et tags de la ligne).
                        Dans Shopify, créez une collection automatique
                        « Type de produit = <field name="shopify_product_type" readonly="1" class="d-inline"/> » :
                        filtrez-la dans OrderBridge (Product Push) et
                        excluez-la dans l'app Amazon.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_marketplace" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">shopify.marketplace</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Ajoutez ici chaque marketplace vers laquelle vous vendez
                (Amazon, Etsy, eBay, Cdiscount, ...). Une seule fois par
                marketplace : ensuite, sur chaque fiche produit, ajoutez
                une ligne "Contenu par marketplace" pour cette
                marketplace afin de lui donner un titre/une description
                propres.
            </p>
        </field>
    </record>
</odoo>
