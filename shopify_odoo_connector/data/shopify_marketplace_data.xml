<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Marketplaces créées par défaut à l'installation du module.
         D'autres marketplaces peuvent être ajoutées librement ensuite
         depuis Shopify > Configuration > Marketplaces (type "Autre /
         générique" : elles n'auront alors que le bloc de champs commun,
         sans bloc réglementaire dédié). -->
    <record id="shopify_marketplace_amazon" model="shopify.marketplace">
        <field name="name">Amazon</field>
        <field name="code">amazon</field>
        <field name="platform_type">amazon</field>
        <field name="sequence">10</field>
    </record>

    <record id="shopify_marketplace_etsy" model="shopify.marketplace">
        <field name="name">Etsy</field>
        <field name="code">etsy</field>
        <field name="platform_type">etsy</field>
        <field name="sequence">20</field>
    </record>

    <record id="shopify_marketplace_tiktok" model="shopify.marketplace">
        <field name="name">TikTok Shop</field>
        <field name="code">tiktok</field>
        <field name="platform_type">tiktok</field>
        <field name="sequence">30</field>
    </record>
</odoo>
