<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Garantit l'existence des 3 marketplaces par défaut (Amazon, Etsy,
        TikTok Shop). Un <function> est rejoué à CHAQUE mise à jour du
        module (contrairement à un <record>, qui provoquerait une erreur
        de contrainte d'unicité si une ligne avec le même code existe déjà
        - par exemple créée manuellement avant cette version du module).
        La méthode fait un vrai "get or create" par code : sans risque de
        doublon, quel que soit l'état de la base au moment de la mise à
        jour. D'autres marketplaces peuvent ensuite être ajoutées librement
        depuis Shopify > Configuration > Marketplaces (type "Autre /
        générique" : elles n'auront alors que le bloc de champs commun,
        sans bloc réglementaire dédié).
    -->
    <function model="shopify.marketplace" name="_shopify_ensure_default_marketplaces" eval="[[]]"/>

    <!--
        v4.2 (une seule fois) : Etsy passe en mode "API Etsy" -> un seul
        produit Shopify ; les éventuels produits Shopify dédiés Etsy créés
        par la v4.1 sont supprimés de Shopify.
    -->
    <function model="shopify.marketplace" name="_shopify_migrate_etsy_api_mode" eval="[[]]"/>

    <!--
        v4.3 (une seule fois) : 1 produit Odoo à 2 fiches -> 1 produit
        Shopify. Etsy = champs standards (OrderBridge), Amazon = métachamps.
    -->
    <function model="shopify.marketplace" name="_shopify_migrate_two_fiches_one_product" eval="[[]]"/>

    <!-- v4.7 : recrée les définitions Shopify pour ajouter « Fiche active ». -->
    <function model="shopify.config" name="_shopify_reset_fiche_definitions_v47" eval="[[]]"/>
    <!-- v4.8 : « Fiche active » devient un sélecteur (many2one) de fiches Odoo. -->
    <function model="shopify.config" name="_shopify_reset_fiche_definitions_v48" eval="[[]]"/>
    <!-- v4.9 : « Fiche active » = liste déroulante (choix envoyés par Odoo). -->
    <function model="shopify.config" name="_shopify_reset_fiche_definitions_v49" eval="[[]]"/>

    <!--
        Rattrape les lignes "Contenu par marketplace" créées AVANT
        l'auto-remplissage (titre/description/prix/stock/image copiés
        depuis le produit à la création) : ne touche que les champs
        actuellement vides sur chaque ligne, jamais une personnalisation
        déjà saisie. Rejoué à chaque mise à jour du module, sans effet
        les fois suivantes (idempotent).
    -->
    <function model="shopify.product.marketplace.content" name="_shopify_marketplace_backfill_existing" eval="[[]]"/>
</odoo>
