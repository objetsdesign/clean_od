<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             RÈGLES SUR LES DOSSIERS (ged.folder)
             ============================================================ -->

        <!-- Utilisateur standard :
             - voit les dossiers racines (navigation "Employés" / "Projets")
             - voit SON propre dossier employé
             - voit les dossiers des projets dont il est membre (follower)
             - voit les dossiers qu'il a lui-même créés -->
        <record id="rule_ged_folder_user" model="ir.rule">
            <field name="name">GED Dossier : accès restreint (mon dossier + mes projets)</field>
            <field name="model_id" ref="model_ged_folder"/>
            <field name="domain_force">
                ['|', '|', '|',
                    ('folder_type', '=', 'root'),
                    ('employee_id.user_id', '=', user.id),
                    ('project_id.message_partner_ids', '=', user.partner_id.id),
                    ('create_uid', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Administrateurs (Responsable RH ou Administrateur technique) : accès total -->
        <record id="rule_ged_folder_admin" model="ir.rule">
            <field name="name">GED Dossier : accès total administrateurs</field>
            <field name="model_id" ref="model_ged_folder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('base.group_system'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ============================================================
             RÈGLES SUR LES DOCUMENTS (ged.document)
             ============================================================ -->

        <!-- Utilisateur standard :
             - voit les documents qu'il a lui-même créés (ses créations)
             - voit les documents de SON dossier employé (employee_id = lui)
             - voit les documents des projets dont il est membre -->
        <record id="rule_ged_document_user" model="ir.rule">
            <field name="name">GED Document : mes créations + mon dossier + mes projets</field>
            <field name="model_id" ref="model_ged_document"/>
            <field name="domain_force">
                ['|', '|',
                    ('create_uid', '=', user.id),
                    ('employee_id.user_id', '=', user.id),
                    ('project_id.message_partner_ids', '=', user.partner_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Administrateurs : accès total, tous dossiers/employés/projets confondus -->
        <record id="rule_ged_document_admin" model="ir.rule">
            <field name="name">GED Document : accès total administrateurs</field>
            <field name="model_id" ref="model_ged_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('base.group_system'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
