<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste standard Odoo des fichiers Word, avec un bouton Aperçu par ligne -->
    <record id="documents_docx_preview_list" model="ir.ui.view">
        <field name="name">documents.document.docx.preview.list</field>
        <field name="model">documents.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Fichiers Word" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="create_date" string="Ajouté le" optional="show"/>
                <button name="action_docx_open_word" type="object" string="Ouvrir dans Word"
                        icon="fa-file-word-o" class="btn-primary"/>
                <button name="action_docx_preview" type="object" string="Aperçu"
                        icon="fa-eye" class="btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="documents_docx_preview_search" model="ir.ui.view">
        <field name="name">documents.document.docx.preview.search</field>
        <field name="model">documents.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Fichiers Word">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_documents_docx_preview_list" model="ir.actions.act_window">
        <field name="name">Aperçu Word</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="documents_docx_preview_list"/>
        <field name="search_view_id" ref="documents_docx_preview_search"/>
        <field name="domain">[
            ('type', '=', 'binary'),
            '|',
            ('mimetype', '=', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'),
            ('name', '=ilike', '%.docx'),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun fichier Word (.docx) dans Documents.</p>
        </field>
    </record>

    <!-- Sous-menu dans l'application Documents (barre du haut) -->
    <menuitem id="menu_docx_preview_root"
              name="Aperçu Word"
              parent="documents.menu_root"
              action="action_documents_docx_preview_list"
              sequence="50"/>

</odoo>
