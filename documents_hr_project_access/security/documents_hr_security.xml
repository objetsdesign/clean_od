<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             Utilisateur standard :
             - voit tout document qu'il a lui-même créé (n'importe où)
             - pour les documents liés à un EMPLOYÉ (res_model = 'hr.employee'),
               ne voit que ceux liés à SA PROPRE fiche employé
             - tous les autres documents (factures, contrats, etc., non liés
               à hr.employee) restent visibles selon la configuration native
               (onglet "Accès" du document/dossier) : cette règle ne les touche pas
             ============================================================ -->
        <record id="rule_documents_hr_employee_own" model="ir.rule">
            <field name="name">Documents : dossier employé personnel uniquement</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="domain_force">
                ['|',
                    ('res_model', '!=', 'hr.employee'),
                    '&amp;', ('res_model', '=', 'hr.employee'),
                        '|',
                            ('res_id', '=', user.employee_id.id),
                            ('create_uid', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- ============================================================
             Administrateurs (Réglages ou Responsable RH) : accès total,
             tous documents, tous employés, sans restriction
             ============================================================ -->
        <record id="rule_documents_hr_admin_all" model="ir.rule">
            <field name="name">Documents : accès total administrateurs</field>
            <field name="model_id" ref="documents.model_documents_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

    </data>
</odoo>
