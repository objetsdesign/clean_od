<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- b2fa.order.asie : modèle indépendant, aucune vue ci-dessous ne référence
         b2fa.quote ou b2fa.order (B2B / Fund Raising). -->

    <record id="view_b2fa_order_asie_list" model="ir.ui.view">
        <field name="name">b2fa.order.asie.list</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <list string="Commandes Asie" decoration-success="state == 'livree'"
                  decoration-danger="state in ('litige','annulee')"
                  decoration-info="state == 'expediee'"
                  decoration-warning="delay_delivery == True">
                <field name="name"/>
                <field name="quote_id"/>
                <field name="date_commande"/>
                <field name="client"/>
                <field name="contact" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="qty" optional="hide" sum="Total Qté"/>
                <field name="amount_ht" widget="monetary" sum="CA Total"/>
                <field name="deposit_received" widget="monetary" optional="show" sum="Acomptes"/>
                <field name="balance_due" widget="monetary" sum="Solde à recevoir"/>
                <field name="state" widget="badge" decoration-success="state == 'livree'"
                       decoration-danger="state in ('litige','annulee')"
                       decoration-info="state == 'expediee'"
                       decoration-warning="state in ('en_production','controle_qualite','prete_expedier')"/>
                <field name="production_source" optional="show"/>
                <field name="carrier" optional="hide"/>
                <field name="date_livraison_prevue" optional="show"/>
                <field name="date_livraison_reelle" optional="hide"/>
                <field name="delay_delivery" optional="hide" widget="boolean_toggle"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_b2fa_order_asie_kanban" model="ir.ui.view">
        <field name="name">b2fa.order.asie.kanban</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="client"/>
                <field name="amount_ht"/>
                <field name="balance_due"/>
                <field name="state"/>
                <field name="currency_id"/>
                <field name="delay_delivery"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <span t-if="record.delay_delivery.raw_value" class="badge text-bg-danger float-end">Retard</span>
                            <div><field name="client"/></div>
                            <div class="text-muted">CA : <field name="amount_ht" widget="monetary"/></div>
                            <div class="text-muted">Solde : <field name="balance_due" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_b2fa_order_asie_form" model="ir.ui.view">
        <field name="name">b2fa.order.asie.form</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <form string="Commande Asie">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="confirmee,en_production,controle_qualite,prete_expedier,expediee,livree"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Retard" bg_color="bg-danger" invisible="not delay_delivery"/>
                    <widget name="web_ribbon" title="Litige" bg_color="bg-danger" invisible="state != 'litige'"/>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">Asie</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="quote_id"/>
                            <field name="client"/>
                            <field name="contact"/>
                            <field name="date_commande"/>
                            <field name="qty"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_ht" widget="monetary"/>
                            <field name="cost" widget="monetary"/>
                            <field name="margin" widget="monetary"/>
                            <field name="deposit_received" widget="monetary"/>
                            <field name="balance_due" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Production &amp; Logistique">
                            <group>
                                <group string="Production">
                                    <field name="production_source"/>
                                    <field name="date_prod_prevue"/>
                                    <field name="date_prod_reelle"/>
                                </group>
                                <group string="Expédition &amp; Livraison">
                                    <field name="date_expedition"/>
                                    <field name="carrier"/>
                                    <field name="logistics_fees" widget="monetary"/>
                                    <field name="tracking_number"/>
                                    <field name="date_livraison_prevue"/>
                                    <field name="date_livraison_reelle"/>
                                    <field name="delay_delivery" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes / Incidents">
                            <field name="notes_incidents"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_b2fa_order_asie_search" model="ir.ui.view">
        <field name="name">b2fa.order.asie.search</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <search string="Commandes Asie">
                <field name="name"/>
                <field name="client"/>
                <field name="quote_id"/>
                <field name="tracking_number"/>
                <filter string="En production" name="en_production" domain="[('state','=','en_production')]"/>
                <filter string="Expédiées" name="expediees" domain="[('state','=','expediee')]"/>
                <filter string="Livrées" name="livrees" domain="[('state','=','livree')]"/>
                <filter string="En litige" name="litige" domain="[('state','=','litige')]"/>
                <filter string="Livraison en retard" name="retard" domain="[('delay_delivery','=',True)]"/>
                <filter string="Solde à recevoir" name="solde" domain="[('balance_due','&gt;',0)]"/>
                <separator/>
                <filter string="Date commande" name="date_commande" date="date_commande"/>
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Client" name="group_client" context="{'group_by':'client'}"/>
                    <filter string="Source production" name="group_source" context="{'group_by':'production_source'}"/>
                    <filter string="Mois de commande" name="group_month" context="{'group_by':'date_commande:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_b2fa_order_asie_pivot" model="ir.ui.view">
        <field name="name">b2fa.order.asie.pivot</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <pivot string="Commandes Asie">
                <field name="state" type="col"/>
                <field name="amount_ht" type="measure"/>
                <field name="balance_due" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_b2fa_order_asie_graph" model="ir.ui.view">
        <field name="name">b2fa.order.asie.graph</field>
        <field name="model">b2fa.order.asie</field>
        <field name="arch" type="xml">
            <graph string="Commandes Asie" type="bar">
                <field name="client" type="row"/>
                <field name="amount_ht" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_b2fa_order_asie" model="ir.actions.act_window">
        <field name="name">Commandes Asie</field>
        <field name="res_model">b2fa.order.asie</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première commande Asie</p>
        </field>
    </record>
</odoo>
