<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- sale.order.sky : porte à elle seule la classification "Asie". Le lien
         vers sale.order n'existe que sur cette fiche (Many2one sale_order_id) :
         aucune de ces vues ne touche donc au modèle sale.order lui-même. -->
    <record id="view_sale_order_sky_list" model="ir.ui.view">
        <field name="name">sale.order.sky.list</field>
        <field name="model">sale.order.sky</field>
        <field name="arch" type="xml">
            <list string="Asie — Devis/Commandes classés">
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="sale_state" string="Statut Ventes"/>
                <field name="amount_total" sum="Total"/>
                <field name="b2fa_quote_id"/>
                <field name="b2fa_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_sky_form" model="ir.ui.view">
        <field name="name">sale.order.sky.form</field>
        <field name="model">sale.order.sky</field>
        <field name="arch" type="xml">
            <form string="Classification Asie">
                <header>
                    <button name="action_b2fa_sync_now" type="object"
                            string="Actualiser dans Suivi Devis &amp; Commandes"
                            class="btn-secondary" icon="fa-refresh"/>
                </header>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_sale_order" type="object"
                            string="Commande Ventes" class="oe_stat_button" icon="fa-external-link"/>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date_order" readonly="1"/>
                        </group>
                        <group>
                            <field name="sale_state" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_untaxed" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                    </group>
                    <group string="Suivi Devis &amp; Commandes">
                        <field name="b2fa_quote_id" readonly="1"/>
                        <field name="b2fa_order_id" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sale_order_sky_search" model="ir.ui.view">
        <field name="name">sale.order.sky.search</field>
        <field name="model">sale.order.sky</field>
        <field name="arch" type="xml">
            <search string="Asie — Devis/Commandes classés">
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <group string="Regrouper par">
                    <filter string="Statut Ventes" name="group_state" context="{'group_by':'sale_state'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_order_sky" model="ir.actions.act_window">
        <field name="name">Asie — Devis/Commandes Ventes classés</field>
        <field name="res_model">sale.order.sky</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_order_sky_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun devis/commande Ventes classé "Asie" pour le moment.
            </p>
            <p>
                Ouvrez un devis/commande dans Ventes et cliquez sur "Classer en Asie",
                ou sélectionnez plusieurs lignes depuis "Classer les Devis/Commandes
                (Ventes)" puis utilisez le bouton "Classer en Asie" en haut de la liste.
                Le devis/commande Ventes original n'est jamais modifié : la classification
                est entièrement portée par cette fiche.
            </p>
        </field>
    </record>
</odoo>
