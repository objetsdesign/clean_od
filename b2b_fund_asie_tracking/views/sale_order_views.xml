<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Small, safe patch on the standard Quotation/Order form: add the activity
         field and a shortcut button. 'user_id' (Salesperson) and the stat-button
         box are stable anchors present on the sale.order form across Odoo versions. -->
    <record id="view_order_form_b2fa_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.b2fa.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="b2fa_activity_type"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_b2fa_sync_now" type="object"
                        string="Actualiser dans Suivi Devis &amp; Commandes"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="not b2fa_activity_type"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated list, owned by this module (not inherited from Sales, to stay
         compatible whatever the exact Odoo point-release view ids are). Used to
         quickly classify existing Ventes quotations/orders per activity: select
         several rows then edit the 'Activité' field on one of them to apply the
         value to the whole selection (native Odoo editable-list behaviour). -->
    <record id="view_b2fa_sale_order_classify_tree" model="ir.ui.view">
        <field name="name">sale.order.b2fa.classify.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Classer les devis / commandes Ventes" editable="bottom" default_order="date_order desc">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="b2fa_activity_type"/>
            </list>
        </field>
    </record>

    <record id="action_b2fa_sale_order_classify" model="ir.actions.act_window">
        <field name="name">Classer les Devis/Commandes (Ventes)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_b2fa_sale_order_classify_tree"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Aucun devis / commande dans Ventes.
            </p>
            <p>
                Sélectionnez une ou plusieurs lignes, puis renseignez la colonne
                "Activité" pour qu'elles soient reprises par la synchronisation
                vers le Suivi Devis &amp; Commandes (menu "Synchroniser depuis Ventes").
            </p>
        </field>
    </record>
</odoo>
