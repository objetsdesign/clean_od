<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Small, safe patch on the standard Quotation/Order form: add the activity
         field and shortcut buttons. 'user_id' (Salesperson) and the stat-button
         box are stable anchors present on the sale.order form across Odoo versions. -->
    <record id="view_order_form_b2fa_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.b2fa.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="b2fa_activity_type"/>
                <field name="b2fa_sky_id" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_b2fa_sync_now" type="object"
                        string="Actualiser dans Suivi Devis &amp; Commandes"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="not b2fa_activity_type"/>
                <!-- Raccourci équivalent à choisir 'Asie' dans le champ Activité
                     ci-dessus : renseigne le champ, ce qui crée/actualise
                     automatiquement la fiche Asie (sale.order.sky). -->
                <button name="action_b2fa_mark_asie" type="object"
                        string="Classer en Asie"
                        class="oe_stat_button" icon="fa-ship"
                        invisible="b2fa_sky_id"/>
                <button name="action_b2fa_open_sky" type="object"
                        string="Fiche Asie"
                        class="oe_stat_button" icon="fa-ship"
                        invisible="not b2fa_sky_id"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated list + search, owned by this module (not inherited from Sales,
         to stay compatible whatever the exact Odoo point-release view ids are).
         Used to classify existing Ventes quotations/orders per activity:
         group/filter by team, source, client... to spot patterns, select several
         rows, then edit the 'Activité' field on one of them to apply the value to
         the whole selection (native Odoo editable-list behaviour) — B2B, Fund
         Raising ET Asie sont choisissables dans cette même colonne. -->
    <record id="view_b2fa_sale_order_classify_search" model="ir.ui.view">
        <field name="name">sale.order.b2fa.classify.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Classer les devis / commandes Ventes">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="source_id"/>
                <filter string="Non classés" name="unclassified" domain="[('b2fa_activity_type','=',False)]"/>
                <filter string="Déjà classés" name="classified" domain="[('b2fa_activity_type','!=',False)]"/>
                <separator/>
                <filter string="B2B Classique" name="filter_b2b" domain="[('b2fa_activity_type','=','b2b')]"/>
                <filter string="Fund Raising" name="filter_fund" domain="[('b2fa_activity_type','=','fund')]"/>
                <filter string="Asie" name="filter_asie" domain="[('b2fa_activity_type','=','asie')]"/>
                <separator/>
                <filter string="Devis (non confirmés)" name="is_quote" domain="[('state','in',('draft','sent'))]"/>
                <filter string="Commandes confirmées" name="is_order" domain="[('state','in',('sale','done'))]"/>
                <separator/>
                <filter string="Annulés" name="is_cancel" domain="[('state','=','cancel')]"/>
                <group string="Regrouper par">
                    <filter string="Équipe commerciale" name="group_team" context="{'group_by':'team_id'}"/>
                    <filter string="Source (UTM)" name="group_source" context="{'group_by':'source_id'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Activité déjà assignée" name="group_activity" context="{'group_by':'b2fa_activity_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_b2fa_sale_order_classify_tree" model="ir.ui.view">
        <field name="name">sale.order.b2fa.classify.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Classer les devis / commandes Ventes" editable="bottom" default_order="date_order desc">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="team_id" optional="show"/>
                <field name="source_id" optional="show" string="Source"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="b2fa_activity_type"/>
                <field name="b2fa_sky_id" optional="hide" string="Fiche Asie"/>
            </list>
        </field>
    </record>

    <record id="action_b2fa_sale_order_classify" model="ir.actions.act_window">
        <field name="name">Classer les Devis/Commandes (Ventes)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_b2fa_sale_order_classify_tree"/>
        <field name="search_view_id" ref="view_b2fa_sale_order_classify_search"/>
        <field name="domain">[]</field>
        <field name="context">{'search_default_unclassified': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Aucun devis / commande dans Ventes.
            </p>
            <p>
                Utilisez les filtres et regroupements (Équipe commerciale, Source,
                Client, Statut) pour repérer des lots homogènes, sélectionnez les
                lignes concernées, puis renseignez la colonne "Activité" (B2B
                Classique / Fund Raising / Asie) sur une seule ligne : Odoo
                applique la valeur à toute la sélection.
                Une fois classées, ces lignes seront reprises par la
                synchronisation vers le Suivi Devis &amp; Commandes.
            </p>
        </field>
    </record>
</odoo>
