    <menuitem id="menu_b2fa_dashboard" name="Tableau de Bord" parent="menu_b2fa_root"
              action="action_b2fa_dashboard" sequence="1"/>

    <!-- "Importer depuis Excel" (action_b2fa_import_wizard) et "Synchroniser depuis Ventes"
         (action_b2fa_sync_wizard) : fonctionnalités conservées côté développeur (le wizard,
         le modèle et l'action restent installés) mais volontairement retirées du menu.
         Accessibles en mode développeur via Paramètres > Technique > Actions > Actions fenêtres,
         ou en les ré-ajoutant plus tard avec un simple <menuitem>. -->

    <menuitem id="menu_b2fa_classify" name="Classer les Devis/Commandes (Ventes)" parent="menu_b2fa_root"
              action="action_b2fa_sale_order_classify" sequence="4"/>

    <menuitem id="menu_b2fa_table" name="Tableau de Suivi" parent="menu_b2fa_root" sequence="5"/>
    <menuitem id="menu_b2fa_table_quote" name="Devis (toutes activités)" parent="menu_b2fa_table"
              action="action_b2fa_quote_all" sequence="1"/>
    <menuitem id="menu_b2fa_table_order" name="Commandes (toutes activités)" parent="menu_b2fa_table"
              action="action_b2fa_order_all" sequence="2"/>

    <menuitem id="menu_b2fa_b2b" name="B2B Classique" parent="menu_b2fa_root" sequence="10"/>
    <menuitem id="menu_b2fa_b2b_quote" name="Devis" parent="menu_b2fa_b2b"
              action="action_b2fa_quote_b2b" sequence="1"/>
    <menuitem id="menu_b2fa_b2b_order" name="Commandes" parent="menu_b2fa_b2b"
              action="action_b2fa_order_b2b" sequence="2"/>

    <menuitem id="menu_b2fa_fund" name="Fund Raising" parent="menu_b2fa_root" sequence="20"/>
