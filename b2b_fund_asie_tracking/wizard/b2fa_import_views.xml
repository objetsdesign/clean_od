<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_b2fa_import_wizard_form" model="ir.ui.view">
        <field name="name">b2fa.import.wizard.form</field>
        <field name="model">b2fa.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Devis &amp; Commandes depuis Excel">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="result_log">
                        Sélectionnez le fichier Excel "Suivi Devis &amp; Commandes" (mêmes onglets
                        DEVIS B2B / COMMANDES B2B / DEVIS FUND / COMMANDES FUND / DEVIS ASIE / COMMANDES ASIE
                        que le fichier d'origine) puis cliquez sur "Importer".
                        <br/>
                        Les lignes déjà importées (même référence + même activité) sont automatiquement
                        ignorées : vous pouvez ré-importer le même fichier sans créer de doublons.
                    </div>
                    <group invisible="result_log">
                        <field name="filename" invisible="1"/>
                        <field name="file" filename="filename" required="1"/>
                    </group>
                    <group invisible="not result_log">
                        <field name="result_log" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Importer" name="action_import" type="object"
                            class="btn-primary" invisible="result_log"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_b2fa_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer depuis Excel</field>
        <field name="res_model">b2fa.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
