<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_b2fa" model="ir.module.category">
        <field name="name">Suivi Devis &amp; Commandes</field>
        <field name="description">Gestion des devis et commandes B2B / Fund Raising / Asie</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_b2fa_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_b2fa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_b2fa_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_b2fa"/>
        <field name="implied_ids" eval="[(4, ref('group_b2fa_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
