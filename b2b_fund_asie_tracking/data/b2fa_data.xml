<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_b2fa_quote_b2b" model="ir.sequence">
        <field name="name">Devis B2B Classique</field>
        <field name="code">b2fa.quote.b2b</field>
        <field name="prefix">DEV-B2B-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_b2fa_quote_fund" model="ir.sequence">
        <field name="name">Devis Fund Raising</field>
        <field name="code">b2fa.quote.fund</field>
        <field name="prefix">DEV-FUND-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_b2fa_quote_asie" model="ir.sequence">
        <field name="name">Devis Asie</field>
        <field name="code">b2fa.quote.asie</field>
        <field name="prefix">DEV-ASIE-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_b2fa_order_b2b" model="ir.sequence">
        <field name="name">Commande B2B Classique</field>
        <field name="code">b2fa.order.b2b</field>
        <field name="prefix">CMD-B2B-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_b2fa_order_fund" model="ir.sequence">
        <field name="name">Commande Fund Raising</field>
        <field name="code">b2fa.order.fund</field>
        <field name="prefix">CMD-FUND-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_b2fa_order_asie" model="ir.sequence">
        <field name="name">Commande Asie</field>
        <field name="code">b2fa.order.asie</field>
        <field name="prefix">CMD-ASIE-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_b2fa_update_delay_delivery" model="ir.cron">
        <field name="name">Suivi Devis &amp; Commandes : mise à jour des retards de livraison</field>
        <field name="model_id" ref="model_b2fa_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_delay_delivery()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
