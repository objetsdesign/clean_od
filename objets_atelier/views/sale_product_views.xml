<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart Button sur sale.order -->
    <record id="view_order_form_atelier_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.atelier</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_atelier_ordres"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="atelier_ordre_count == 0">
                    <field name="atelier_ordre_count" widget="statinfo" string="Ordres Atelier"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Champ « Fabriqué à l'atelier » sur product.template -->
    <record id="product_template_only_form_view_atelier" model="ir.ui.view">
        <field name="name">product.template.form.atelier</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-block">
                    <field name="fabrique_atelier"/>
                    <label for="fabrique_atelier"/>
                </span>
            </div>
        </field>
    </record>

</odoo>
