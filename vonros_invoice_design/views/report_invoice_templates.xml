<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Colonnes A..G de l'Excel FA_10019 (largeurs Excel converties en %) -->
    <template id="vr_cols">
        <colgroup>
            <col style="width:8.9%"/>
            <col style="width:9.6%"/>
            <col style="width:27.4%"/>
            <col style="width:21.8%"/>
            <col style="width:11.2%"/>
            <col style="width:9.3%"/>
            <col style="width:11.8%"/>
        </colgroup>
    </template>

    <template id="report_invoice_document_vonros">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="company" t-value="o.company_id"/>
            <t t-set="partner" t-value="o.partner_id"/>
            <t t-set="ship" t-value="o.partner_shipping_id"/>
            <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
            <t t-set="monetary" t-value="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            <t t-set="contact_od" t-value="partner.child_ids.filtered(lambda c: c.type == 'contact')[:1]"/>

            <div class="page vrinv">
                <style>
/* Von Ros Industry – facture calquée sur le fichier Excel FA_10019.xlsx
   Toutes les tailles = valeurs Excel x 0.9 (mise à l'échelle pour tenir sur une page A4,
   comme l'impression Excel "ajuster à la page"). Unités en pt, comme dans Excel. */

@font-face { font-family: 'Caladea'; font-weight: normal; font-style: normal;
    src: url('/vonros_invoice_design/static/src/fonts/Caladea-Regular.ttf') format('truetype'); }
@font-face { font-family: 'Caladea'; font-weight: bold; font-style: normal;
    src: url('/vonros_invoice_design/static/src/fonts/Caladea-Bold.ttf') format('truetype'); }
@font-face { font-family: 'Caladea'; font-weight: normal; font-style: italic;
    src: url('/vonros_invoice_design/static/src/fonts/Caladea-Italic.ttf') format('truetype'); }
@font-face { font-family: 'Carlito'; font-weight: normal; font-style: normal;
    src: url('/vonros_invoice_design/static/src/fonts/Carlito-Regular.ttf') format('truetype'); }
@font-face { font-family: 'VR Sans'; font-weight: normal; font-style: normal;
    src: url('/vonros_invoice_design/static/src/fonts/LiberationSans-Regular.ttf') format('truetype'); }
@font-face { font-family: 'VR Sans'; font-weight: bold; font-style: normal;
    src: url('/vonros_invoice_design/static/src/fonts/LiberationSans-Bold.ttf') format('truetype'); }

.vrinv { font-family: Cambria, 'Caladea', Georgia, serif; font-size: 9.9pt; color: #000; line-height: 1.15; }
.vrinv * { box-sizing: border-box; }
.vrinv table.g { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0; }
.vrinv table, .vrinv tr, .vrinv th, .vrinv td { border: 0 none !important; background-color: transparent; }
.vrinv table.g td { padding: 0 2.5pt; vertical-align: middle; white-space: nowrap; overflow: visible; }

/* polices Excel */
.vrinv .arial  { font-family: Arial, 'VR Sans', Helvetica, sans-serif; }
.vrinv .calibri { font-family: Calibri, 'Carlito', Arial, sans-serif; }

/* couleurs Excel */
.vrinv .grey  { color: #6B6B6B; }
.vrinv .light { color: #9A9A9A; }
.vrinv .dark  { color: #595959; }
.vrinv .b { font-weight: bold; }
.vrinv .i { font-style: italic; }
.vrinv .r { text-align: right; }
.vrinv .c { text-align: center; }
.vrinv .l { text-align: left; }

.vrinv .s14 { font-size: 12.6pt; }
.vrinv .s12 { font-size: 10.8pt; }
.vrinv .s11 { font-size: 9.9pt; }
.vrinv .s10 { font-size: 9pt; }

/* bordures Excel */
.vrinv table.g td.ul   { border-bottom: 0.75pt solid #D4D4D4 !important; }   /* thin D4D4D4 */
.vrinv table.g td.ulh  { border-bottom: 0.75pt solid #D9C9B6 !important; }   /* thin D9C9B6 (en-tête lignes) */
.vrinv table.g td.rule { border-bottom: 1.5pt solid #000 !important; }       /* medium noir (ligne 5) */

/* remplissages Excel */
.vrinv table.g td.f-head { background-color: #F2EBE3 !important; }   /* en-tête tableau + NET À PAYER */
.vrinv table.g td.f-grey { background-color: #F2F2F2 !important; }   /* colonnes SKU / Qté / Montant */
.vrinv table.g td.f-band { background-color: #FDE9D9 !important; }   /* bande après les lignes */

/* logo : ancré col. A + 33pt, ligne 2, 143x53pt dans Excel */
.vrinv .logo { position: absolute; left: 33pt; top: 22pt; width: 129pt; height: 47.4pt; }

.vrinv .obs p { display: inline; margin: 0; }
.vrinv .obs style { display: none; }
.vrinv table.g td.wrap { white-space: normal; word-wrap: break-word; overflow: hidden; padding-top: 1.5pt; padding-bottom: 1.5pt; }

                </style>


                <!-- ============ LIGNES 1-5 : LOGO + SOCIÉTÉ + FILET NOIR ============ -->
                <div style="position:relative;">
                    <img class="logo" src="/vonros_invoice_design/static/src/img/logo.png"/>
                    <table class="g">
                        <t t-call="vonros_invoice_design.vr_cols"/>
                        <tr style="height:19.8pt;"><td colspan="7"/></tr>
                        <tr style="height:19.8pt;">
                            <td colspan="4"/>
                            <td colspan="3" class="r b s12">Von Ros Industry</td>
                        </tr>
                        <tr style="height:19.8pt;">
                            <td colspan="4"/>
                            <td colspan="3" class="r grey s12">Rond-Point Rawebi, Route d'Akouda</td>
                        </tr>
                        <tr style="height:19.8pt;">
                            <td colspan="4"/>
                            <td colspan="3" class="r grey s12">4021 Kalâa Seghira — Sousse, Tunisie</td>
                        </tr>
                        <tr style="height:12.6pt;">
                            <td class="rule"/><td class="rule"/><td class="rule"/><td class="rule"/>
                            <td class="rule"/><td class="rule"/><td class="rule"/>
                        </tr>
                        <tr style="height:13.5pt;"><td colspan="7"/></tr>

                        <!-- ============ LIGNES 7-8 : FACTURE / N° / DATE ============ -->
                        <tr style="height:27pt;">
                            <td colspan="4" class="l b s14">
                                <t t-if="o.move_type == 'out_refund'">AVOIR</t>
                                <t t-else="">FACTURE</t>
                            </td>
                            <td colspan="3" class="r b s14">N° <span t-out="o.name if o.name and o.name != '/' else ''"/></td>
                        </tr>
                        <tr style="height:13.5pt;">
                            <td colspan="5"/>
                            <td colspan="2" class="r grey s10"><span t-field="o.invoice_date" t-options="{'format': 'dd/MM/yyyy'}"/></td>
                        </tr>
                        <tr style="height:13.5pt;"><td colspan="7"/></tr>
                        <tr style="height:7.2pt;"><td colspan="7"/></tr>

                        <!-- ============ LIGNE 11 : FACTURÉ À / RÉFÉRENCES ============ -->
                        <tr style="height:16.2pt;">
                            <td colspan="3" class="ul b light" style="vertical-align:bottom;">FACTURÉ À</td>
                            <td/>
                            <td colspan="3" class="ul b light" style="vertical-align:bottom;">RÉFÉRENCES</td>
                        </tr>

                        <!-- ============ LIGNES 12-17 ============ -->
                        <tr>
                            <td colspan="4" style="vertical-align:top; padding:0;">
                                <table class="g">
                                    <colgroup>
                                        <col style="width:13.1%"/><col style="width:14.2%"/>
                                        <col style="width:40.5%"/><col style="width:32.2%"/>
                                    </colgroup>
                                    <tr style="height:14.4pt;"><td colspan="4" class="b" t-out="partner.name"/></tr>
                                    <tr t-if="partner.street" style="height:13.5pt;"><td colspan="4" t-out="partner.street"/></tr>
                                    <tr t-if="partner.street2" style="height:13.5pt;"><td colspan="4" t-out="partner.street2"/></tr>
                                    <tr style="height:13.5pt;">
                                        <td colspan="4" class="grey">
                                            <span t-out="partner.zip"/> <span t-out="partner.city"/><t t-if="partner.country_id"> — <span t-out="partner.country_id.name"/></t>
                                        </td>
                                    </tr>
                                    <tr t-if="partner.company_registry" style="height:13.5pt;">
                                        <td colspan="4" class="grey">RCS <span t-out="partner.company_registry"/></td>
                                    </tr>
                                    <tr t-if="partner.vat" style="height:13.5pt;">
                                        <td class="i s12">VAT Nr:</td>
                                        <td colspan="3" class="s12" t-out="partner.vat"/>
                                    </tr>
                                    <tr t-if="partner.eori_number" style="height:13.5pt;">
                                        <td class="i s12">Eori Nr:</td>
                                        <td colspan="3" class="s12" t-out="partner.eori_number"/>
                                    </tr>
                                </table>
                            </td>
                            <td colspan="3" style="vertical-align:top; padding:0;">
                                <table class="g">
                                    <colgroup><col style="width:34.6%"/><col style="width:65.4%"/></colgroup>
                                    <tr style="height:14.4pt;"><td class="grey">Commande</td><td t-out="o.ref"/></tr>
                                    <tr style="height:13.5pt;"><td class="grey">Devis</td><td t-out="o.invoice_origin"/></tr>
                                    <tr style="height:13.5pt;"><td class="grey">Contact VRI</td><td t-out="o.invoice_user_id.name"/></tr>
                                    <tr style="height:13.5pt;"><td class="grey">Contact OD</td><td t-out="contact_od.name"/></tr>
                                    <tr style="height:13.5pt;"><td class="grey">Devise</td><td t-out="o.currency_id.currency_unit_label or o.currency_id.name"/></tr>
                                    <tr style="height:13.5pt;">
                                        <td class="grey">Incoterm</td>
                                        <td class="grey"><span t-out="o.invoice_incoterm_id.code"/> <span t-out="o.incoterm_location"/></td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr style="height:13.5pt;"><td colspan="7"/></tr>
                    </table>
                </div>

                <!-- ============ LIGNE 19 + : TABLEAU DES LIGNES ============ -->
                <table class="g">
                    <t t-call="vonros_invoice_design.vr_cols"/>
                    <thead>
                        <tr style="height:18pt;">
                            <td class="f-head ulh b c">Réf.</td>
                            <td class="f-head ulh b c">SKU</td>
                            <td colspan="2" class="f-head ulh b c">Désignation</td>
                            <td class="f-head ulh b c">Qté</td>
                            <td class="f-head ulh b c">P.U. HT</td>
                            <td class="f-head ulh b c">Montant HT</td>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line" style="height:16.2pt; page-break-inside:avoid;">
                            <td class="ul arial l wrap" t-out="line._vr_ref()"/>
                            <td class="ul f-grey s10" t-out="line.product_id.default_code"/>
                            <td colspan="2" class="ul calibri l wrap" t-out="line._vr_designation()"/>
                            <td class="ul f-grey s10 c"><span t-out="line.quantity" t-options="{'widget': 'float', 'precision': 0}"/></td>
                            <td class="ul r"><span t-field="line.price_unit" t-options="monetary"/></td>
                            <td class="ul f-grey r"><span t-field="line.price_subtotal" t-options="monetary"/></td>
                        </tr>
                    </tbody>
                </table>

                <!-- ============ LIGNES 34-41 : BANDE / OBSERVATIONS / TOTAUX / LIVRAISON ============ -->
                <table class="g" style="page-break-inside:avoid;">
                    <t t-call="vonros_invoice_design.vr_cols"/>
                    <tr style="height:14.4pt;">
                        <td colspan="4" class="f-band"/>
                        <td class="f-band ul"/><td class="f-band ul"/><td class="f-band ul"/>
                    </tr>
                    <tr style="height:17.1pt;">
                        <td colspan="4" class="arial obs wrap"><t t-if="o.narration">Observations:&#160; <span t-out="o.narration"/></t></td>
                        <td colspan="2" class="ul r">Total HT</td>
                        <td class="ul r"><span t-field="o.amount_untaxed" t-options="monetary"/></td>
                    </tr>
                    <tr style="height:14.4pt;">
                        <td colspan="4" class="arial b"><t t-if="ship">Adresse de livraison</t></td>
                        <t t-if="o.amount_tax">
                            <td colspan="2" class="ul r">TVA</td>
                            <td class="ul r"><span t-field="o.amount_tax" t-options="monetary"/></td>
                        </t>
                        <t t-else=""><td colspan="2" class="ul"/><td class="ul"/></t>
                    </tr>
                    <tr style="height:14.4pt;">
                        <td colspan="4" class="arial" t-out="ship.name if ship else ''"/>
                        <td colspan="2" class="ul f-head b r">NET À PAYER</td>
                        <td class="ul f-head b r"><span t-field="o.amount_total" t-options="monetary"/></td>
                    </tr>
                    <tr t-if="ship and ship.street" style="height:14.4pt;"><td colspan="4" class="arial" t-out="ship.street"/><td colspan="3"/></tr>
                    <tr t-if="ship and ship.street2" style="height:14.4pt;"><td colspan="4" class="arial" t-out="ship.street2"/><td colspan="3"/></tr>
                    <tr t-if="ship and (ship.zip or ship.city or ship.country_id)" style="height:14.4pt;">
                        <td colspan="4" class="arial"><span t-out="ship.zip"/> <span t-out="ship.city"/><t t-if="ship.country_id">. <span t-out="ship.country_id.name"/></t></td><td colspan="3"/>
                    </tr>
                    <tr t-if="ship" style="height:14.4pt;">
                        <td colspan="4" class="arial">Contact: <span t-out="ship.phone or ''"/></td><td colspan="3"/>
                    </tr>
                    <tr style="height:10.8pt;"><td colspan="7"/></tr>

                    <!-- ============ LIGNES 42-47 : INFORMATIONS ============ -->
                    <tr style="height:13.5pt;">
                        <td class="ul b light">Informations</td>
                        <td class="ul"/><td class="ul"/><td class="ul"/><td class="ul"/><td class="ul"/><td class="ul"/>
                    </tr>
                    <tr style="height:13.5pt;">
                        <td class="b grey">Livraison</td>
                        <td class="b grey">incoterm</td>
                        <td colspan="5" class="grey"><span t-out="o.invoice_incoterm_id.code"/> <span t-out="o.incoterm_location"/></td>
                    </tr>
                    <tr style="height:13.5pt;">
                        <td colspan="2" class="b grey">Règlement</td>
                        <td colspan="5" class="grey">Virement bancaire portant la référence de la présente facture</td>
                    </tr>
                    <tr style="height:13.5pt;">
                        <td colspan="2" class="b grey">TVA</td>
                        <td colspan="5" class="grey">
                            <t t-if="o.fiscal_position_id and o.fiscal_position_id.note"><span t-out="o.fiscal_position_id.note"/></t>
                            <t t-elif="not o.amount_tax">Exonérée — entreprise totalement exportatrice</t>
                            <t t-else="">Selon taxes ci-dessus</t>
                        </td>
                    </tr>
                    <tr style="height:13.5pt;">
                        <td colspan="2" class="b grey">Imputation</td>
                        <td colspan="5" class="grey" t-out="o.payment_reference if o.payment_reference and o.payment_reference != o.name else ''"/>
                    </tr>
                    <tr style="height:13.5pt;">
                        <td colspan="2" class="b dark">Paiement</td>
                        <td colspan="5" class="dark" t-out="o.invoice_payment_term_id.name or 'A réception'"/>
                    </tr>

                    <!-- ============ LIGNES 48-50 : PIED ============ -->
                    <tr style="height:14.4pt;"><td colspan="7" class="c b">Von Ros Industry</td></tr>
                    <tr style="height:11.7pt;">
                        <td colspan="7" class="c light">Rond-Point Rawebi, Route d'Akouda, 4021 Kalâa Seghira, Sousse, Tunisie</td>
                    </tr>
                    <tr style="height:11.7pt;">
                        <td colspan="7" class="c light">Matricule fiscal 1915693LAM000&#160;&#160;·&#160;&#160;RNE 1915693L</td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <!-- Branche supplémentaire dans le rapport facture standard (sinon le PDF sort vide) -->
    <template id="report_invoice_vonros_branch" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-if="o._get_name_invoice_report() == 'vonros_invoice_design.report_invoice_document_vonros'"
               t-call="vonros_invoice_design.report_invoice_document_vonros"
               t-lang="lang"/>
        </xpath>
    </template>
</odoo>
