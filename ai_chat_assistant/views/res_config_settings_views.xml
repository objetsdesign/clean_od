<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ai_chat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.chat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Assistant IA" string="Assistant IA"
                     data-key="ai_chat_assistant" groups="base.group_system">
                    <h2>Assistant IA</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_provider"/>
                                <div class="text-muted">
                                    Choisissez le fournisseur du modèle de langage utilisé par le chat.
                                </div>
                                <field name="ai_chat_provider"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_model"/>
                                <div class="text-muted">
                                    Ex: gpt-4o-mini (OpenAI) ou claude-sonnet-4-6 (Anthropic).
                                </div>
                                <field name="ai_chat_model" placeholder="gpt-4o-mini"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_api_key"/>
                                <div class="text-muted">Clé API du fournisseur choisi.</div>
                                <field name="ai_chat_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_base_url"/>
                                <div class="text-muted">
                                    Optionnel: URL d'un endpoint compatible auto-hébergé (Ollama, LM Studio...).
                                </div>
                                <field name="ai_chat_base_url" placeholder="https://api.openai.com/v1"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_chat_max_results"/>
                                <div class="text-muted">
                                    Nombre max de lignes renvoyées par recherche (factures, devis...).
                                </div>
                                <field name="ai_chat_max_results"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
