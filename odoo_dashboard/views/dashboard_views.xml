<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_odoo_dashboard_form" model="ir.ui.view">
        <field name="name">odoo.dashboard.form</field>
        <field name="model">odoo.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Global" create="false" delete="false" edit="false">
                <header>
                    <button name="action_refresh" type="object"
                            string="Actualiser" class="btn-primary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Vue globale des modules Odoo</h1>
                        <p class="text-muted">
                            Cliquez sur un bloc pour ouvrir le module correspondant.
                            Les blocs à 0 correspondent à des modules non installés
                            ou sans données.
                        </p>
                    </div>

                    <div class="row mt16" style="width:100%;">

                        <div class="col-3 mb16">
                            <button name="action_open_sales" type="object" class="oe_stat_button" icon="fa-usd">
                                <field name="sales_count" widget="statinfo" string="Ventes"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_purchase" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                                <field name="purchase_count" widget="statinfo" string="Achats"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <field name="invoice_count" widget="statinfo" string="Factures"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_stock" type="object" class="oe_stat_button" icon="fa-truck">
                                <field name="stock_count" widget="statinfo" string="Transferts stock"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_mrp" type="object" class="oe_stat_button" icon="fa-cogs">
                                <field name="mrp_count" widget="statinfo" string="Fabrication"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_pos" type="object" class="oe_stat_button" icon="fa-shopping-basket">
                                <field name="pos_count" widget="statinfo" string="Point de vente"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_crm" type="object" class="oe_stat_button" icon="fa-bullseye">
                                <field name="crm_count" widget="statinfo" string="CRM"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-tasks">
                                <field name="project_count" widget="statinfo" string="Projets"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_employees" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="employee_count" widget="statinfo" string="Employés"/>
                            </button>
                        </div>

                        <div class="col-3 mb16">
                            <button name="action_open_helpdesk" type="object" class="oe_stat_button" icon="fa-life-ring">
                                <field name="helpdesk_count" widget="statinfo" string="Support"/>
                            </button>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dashboard_main_record" model="odoo.dashboard">
        <field name="name">Dashboard Global</field>
    </record>

    <record id="action_global_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Global</field>
        <field name="res_model">odoo.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odoo_dashboard_form"/>
        <field name="res_id" ref="dashboard_main_record"/>
        <field name="target">current</field>
    </record>

</odoo>
