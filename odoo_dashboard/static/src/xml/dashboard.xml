<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="odoo_dashboard.Dashboard" owl="1">
    <div class="o_dashboard_global">

      <!-- ==================== MENU VERTICAL ==================== -->
      <div class="o_dashboard_sidebar">
        <div class="o_dashboard_sidebar_header">
          <i class="fa fa-th-large"/>
          <span>Modules Odoo</span>
        </div>

        <div class="o_dashboard_sidebar_total" t-if="!state.loading">
          <span class="o_total_number" t-esc="state.totalRecords"/>
          <span class="o_total_label">enregistrements au total</span>
        </div>

        <div class="o_dashboard_menu">
          <t t-foreach="state.modules" t-as="mod" t-key="mod.key">
            <div t-att-class="'o_dashboard_menu_item' + (state.selected === mod.key ? ' active' : '') + (!mod.installed ? ' disabled' : '')"
                 t-att-style="'--mod-color:' + mod.color"
                 t-on-click="() => this.selectModule(mod.key)">
              <span class="o_dashboard_menu_icon">
                <i t-att-class="'fa ' + mod.icon"/>
              </span>
              <span class="o_dashboard_menu_label" t-esc="mod.label"/>
              <span class="o_dashboard_menu_badge" t-esc="state.counts[mod.key] || 0"/>
            </div>
          </t>
        </div>

        <div class="o_dashboard_sidebar_footer">
          <button class="btn btn-sm o_refresh_btn" t-on-click="refresh">
            <i class="fa fa-refresh"/> Actualiser
          </button>
        </div>
      </div>

      <!-- ==================== CONTENU ==================== -->
      <div class="o_dashboard_content">

        <t t-if="state.loading">
          <div class="o_dashboard_loading">
            <i class="fa fa-spinner fa-spin"/>
            <p>Chargement du dashboard...</p>
          </div>
        </t>

        <t t-else="">
          <div class="o_dashboard_content_header" t-att-style="'--mod-color:' + (currentModule.color || '#875A7B')">
            <div class="o_header_left">
              <div class="o_header_icon">
                <i t-att-class="'fa ' + (currentModule.icon || 'fa-th')"/>
              </div>
              <div>
                <h2 t-esc="currentModule.label"/>
                <span class="o_header_subtitle">
                  <t t-esc="state.records.length"/> enregistrement(s) affiché(s)
                  sur <t t-esc="state.counts[state.selected] || 0"/> au total
                </span>
              </div>
            </div>
            <button class="btn btn-primary o_view_all_btn" t-on-click="openFullView">
              <i class="fa fa-external-link"/> Voir tout
            </button>
          </div>

          <t t-if="state.loadingRecords">
            <div class="o_dashboard_loading">
              <i class="fa fa-spinner fa-spin"/>
              <p>Chargement des données...</p>
            </div>
          </t>

          <t t-elif="!currentModule.installed">
            <div class="o_dashboard_empty">
              <i class="fa fa-plug"/>
              <p>Ce module n'est pas installé sur cette base Odoo.</p>
            </div>
          </t>

          <t t-else="">
            <div class="o_dashboard_table_wrapper">
              <table class="o_dashboard_table">
                <thead>
                  <tr>
                    <t t-foreach="state.fieldDefs" t-as="f" t-key="f.name">
                      <th t-esc="f.label"/>
                    </t>
                    <th class="o_actions_col"/>
                  </tr>
                </thead>
                <tbody>

                  <!-- ============ LIGNE D'AJOUT RAPIDE (+) ============ -->
                  <tr class="o_add_row">
                    <t t-if="!state.addingRow">
                      <td t-att-colspan="state.fieldDefs.length"
                          class="o_add_row_placeholder"
                          t-on-click="startAddRow">
                        <i class="fa fa-plus-circle"/> Ajouter une ligne...
                      </td>
                      <td class="o_actions_col"/>
                    </t>
                    <t t-else="">
                      <t t-foreach="state.fieldSpecs" t-as="spec" t-key="spec.name">
                        <td>
                          <t t-if="spec.readonly">
                            <span class="o_readonly_hint" title="Champ calculé automatiquement par Odoo">
                              auto
                            </span>
                          </t>
                          <t t-elif="spec.type === 'many2one'">
                            <div class="o_m2o_input_wrapper">
                              <input type="text" class="o_inline_input"
                                     t-att-placeholder="spec.label"
                                     t-att-value="(state.newRowValues[spec.name] &amp;&amp; state.newRowValues[spec.name].name) || ''"
                                     t-on-input="(ev) => this.onMany2oneInput(spec, ev.target.value)"/>
                              <div class="o_m2o_dropdown" t-if="(state.m2oSearchResults[spec.name] || []).length">
                                <t t-foreach="state.m2oSearchResults[spec.name]" t-as="opt" t-key="opt.id">
                                  <div class="o_m2o_option"
                                       t-on-click="() => this.selectMany2oneOption(spec, opt)"
                                       t-esc="opt.name"/>
                                </t>
                              </div>
                            </div>
                          </t>
                          <t t-elif="spec.type === 'selection'">
                            <select class="o_inline_input"
                                    t-on-change="(ev) => this.updateNewRowValue(spec.name, ev.target.value)">
                              <option value="">-</option>
                              <t t-foreach="spec.selection || []" t-as="opt" t-key="opt[0]">
                                <option t-att-value="opt[0]" t-esc="opt[1]"/>
                              </t>
                            </select>
                          </t>
                          <t t-elif="spec.type === 'boolean'">
                            <input type="checkbox"
                                   t-on-change="(ev) => this.updateNewRowValue(spec.name, ev.target.checked)"/>
                          </t>
                          <t t-elif="isDateType(spec)">
                            <input type="date" class="o_inline_input"
                                   t-on-change="(ev) => this.updateNewRowValue(spec.name, ev.target.value)"/>
                          </t>
                          <t t-elif="isNumericType(spec)">
                            <input type="number" step="0.01" class="o_inline_input"
                                   t-att-placeholder="spec.label"
                                   t-on-input="(ev) => this.updateNewRowValue(spec.name, ev.target.value)"/>
                          </t>
                          <t t-else="">
                            <input type="text" class="o_inline_input"
                                   t-att-placeholder="spec.label"
                                   t-on-input="(ev) => this.updateNewRowValue(spec.name, ev.target.value)"/>
                          </t>
                        </td>
                      </t>
                      <td class="o_actions_col o_add_row_actions">
                        <button class="o_row_ok_btn" title="Enregistrer"
                                t-att-disabled="state.savingRow"
                                t-on-click="saveNewRow">
                          <i class="fa fa-check"/>
                        </button>
                        <button class="o_row_cancel_btn" title="Annuler"
                                t-on-click="cancelAddRow">
                          <i class="fa fa-times"/>
                        </button>
                      </td>
                    </t>
                  </tr>

                  <!-- ============ LIGNES EXISTANTES ============ -->
                  <t t-if="state.records.length">
                    <t t-foreach="state.records" t-as="rec" t-key="rec.id">

                      <!-- Ligne en mode édition sur place, sinon ligne normale (lecture) -->
                      <tr t-if="state.editingId === rec.id" class="o_edit_row">
                        <t t-foreach="state.fieldSpecs" t-as="spec" t-key="spec.name">
                          <td>
                            <t t-if="spec.readonly">
                              <span class="o_readonly_hint" t-esc="getFieldValue(rec, spec.name)"/>
                            </t>
                            <t t-elif="spec.type === 'many2one'">
                              <div class="o_m2o_input_wrapper">
                                <input type="text" class="o_inline_input"
                                       t-att-placeholder="spec.label"
                                       t-att-value="(state.editValues[spec.name] &amp;&amp; state.editValues[spec.name].name) || ''"
                                       t-on-input="(ev) => this.onEditMany2oneInput(spec, ev.target.value)"/>
                                <div class="o_m2o_dropdown" t-if="(state.editM2oResults[spec.name] || []).length">
                                  <t t-foreach="state.editM2oResults[spec.name]" t-as="opt" t-key="opt.id">
                                    <div class="o_m2o_option"
                                         t-on-click="() => this.selectEditMany2oneOption(spec, opt)"
                                         t-esc="opt.name"/>
                                  </t>
                                </div>
                              </div>
                            </t>
                            <t t-elif="spec.type === 'selection'">
                              <select class="o_inline_input"
                                      t-on-change="(ev) => this.updateEditValue(spec.name, ev.target.value)">
                                <option value="">-</option>
                                <t t-foreach="spec.selection || []" t-as="opt" t-key="opt[0]">
                                  <option t-att-value="opt[0]"
                                          t-att-selected="state.editValues[spec.name] === opt[0]"
                                          t-esc="opt[1]"/>
                                </t>
                              </select>
                            </t>
                            <t t-elif="spec.type === 'boolean'">
                              <input type="checkbox"
                                     t-att-checked="state.editValues[spec.name]"
                                     t-on-change="(ev) => this.updateEditValue(spec.name, ev.target.checked)"/>
                            </t>
                            <t t-elif="isDateType(spec)">
                              <input type="date" class="o_inline_input"
                                     t-att-value="state.editValues[spec.name]"
                                     t-on-change="(ev) => this.updateEditValue(spec.name, ev.target.value)"/>
                            </t>
                            <t t-elif="isNumericType(spec)">
                              <input type="number" step="0.01" class="o_inline_input"
                                     t-att-value="state.editValues[spec.name]"
                                     t-on-input="(ev) => this.updateEditValue(spec.name, ev.target.value)"/>
                            </t>
                            <t t-else="">
                              <input type="text" class="o_inline_input"
                                     t-att-value="state.editValues[spec.name]"
                                     t-on-input="(ev) => this.updateEditValue(spec.name, ev.target.value)"/>
                            </t>
                          </td>
                        </t>
                        <td class="o_actions_col o_add_row_actions">
                          <button class="o_row_ok_btn" title="Enregistrer"
                                  t-att-disabled="state.savingRow"
                                  t-on-click.stop="(ev) => this.saveEditRow(rec.id, ev)">
                            <i class="fa fa-check"/>
                          </button>
                          <button class="o_row_cancel_btn" title="Annuler"
                                  t-on-click.stop="(ev) => this.cancelEditRow(ev)">
                            <i class="fa fa-times"/>
                          </button>
                        </td>
                      </tr>

                      <tr t-else="" t-on-click="() => this.openRecord(rec.id)">
                        <t t-foreach="state.fieldDefs" t-as="f" t-key="f.name">
                          <td>
                            <span t-att-class="'o_badge ' + getStateBadgeClass(rec, f.name)"
                                  t-esc="getFieldValue(rec, f.name)"/>
                          </td>
                        </t>
                        <td class="o_actions_col">
                          <button class="o_row_edit_btn" title="Modifier"
                                  t-on-click.stop="(ev) => this.startEditRow(rec, ev)">
                            <i class="fa fa-pencil"/>
                          </button>
                          <button class="o_row_delete_btn" title="Supprimer"
                                  t-on-click.stop="(ev) => this.deleteRecord(rec.id, ev)">
                            <i class="fa fa-minus-circle"/>
                          </button>
                        </td>
                      </tr>
                    </t>
                  </t>
                  <t t-else="">
                    <tr class="o_empty_row">
                      <td t-att-colspan="state.fieldDefs.length + 1">
                        Aucun enregistrement pour le moment.
                      </td>
                    </tr>
                  </t>

                </tbody>
              </table>
            </div>
          </t>
        </t>
      </div>
    </div>
  </t>

</templates>
