<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bulletin_paie_tn_v2">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page bp-bulletin">
                        <div class="bp-title">Bulletin de paie</div>
                        <div class="bp-subtitle">
                            <span t-esc="o.company_id.name"/>
                        </div>

                        <div class="bp-info-box">
                            <div class="bp-info-col">
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Employé :</span>
                                    <span t-esc="o.employee_id.name"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">CIN :</span>
                                    <span t-esc="o.employee_id.cin or '—'"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">N° CNSS :</span>
                                    <span t-esc="o.employee_id.cnss_number or '—'"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Poste :</span>
                                    <span t-esc="o.employee_id.job_id.name or ''"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Département :</span>
                                    <span t-esc="o.departement_id.name or ''"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Catégorie professionnelle :</span>
                                    <span t-esc="o.contract_id.categorie_pro or '—'"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Échelon :</span>
                                    <span t-esc="o.contract_id.echelon or '—'"/>
                                </div>
                            </div>
                            <div class="bp-info-col bp-info-col-right">
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Période :</span>
                                    <span t-esc="o.date_from" t-options="{'widget': 'date'}"/>
                                    au
                                    <span t-esc="o.date_to" t-options="{'widget': 'date'}"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Situation familiale :</span>
                                    <span t-esc="o.employee_id.situation_familiale or ''"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Enfants à charge :</span>
                                    <span t-esc="o.employee_id.nombre_enfants_charge or 0"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Parents à charge :</span>
                                    <span t-esc="o.employee_id.nombre_parents_charge or 0"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Date début contrat :</span>
                                    <span t-esc="o.contract_id.date_start"
                                          t-options="{'widget': 'date'}"/>
                                </div>
                                <div class="bp-info-row">
                                    <span class="bp-info-label">Salaire contractuel :</span>
                                    <span t-esc="'%.3f' % o.contract_id.wage"/>
                                    <span t-esc="o.currency_id.symbol"/>
                                </div>
                            </div>
                        </div>

                        <h5 class="bp-section-title">Gains et présences</h5>
                        <table class="bp-table bp-table-gains">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th class="bp-num">Heures</th>
                                    <th class="bp-num">Jours</th>
                                    <th class="bp-num">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.worked_days_line_ids" t-as="wd">
                                    <td><span t-esc="wd.name"/></td>
                                    <td class="bp-num"><span t-esc="'%.1f' % wd.number_of_hours"/></td>
                                    <td class="bp-num"><span t-esc="'%.1f' % wd.number_of_days"/></td>
                                    <td class="bp-num"><span t-esc="'%.3f' % wd.amount"/></td>
                                </tr>
                                <tr class="bp-row-total">
                                    <td><b>Total</b></td>
                                    <td class="bp-num">
                                        <b t-esc="'%.1f' % sum(o.worked_days_line_ids.mapped('number_of_hours'))"/>
                                    </td>
                                    <td class="bp-num">
                                        <b t-esc="'%.1f' % sum(o.worked_days_line_ids.mapped('number_of_days'))"/>
                                    </td>
                                    <td class="bp-num">
                                        <b t-esc="'%.3f' % sum(o.worked_days_line_ids.mapped('amount'))"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="bp-section-title">Calcul de salaire</h5>
                        <table class="bp-table">
                            <thead>
                                <tr>
                                    <th>Rubrique</th>
                                    <th class="bp-num">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line.appears_on_payslip">
                                        <tr t-attf-class="{{ 'bp-row-retenue' if line.total &lt; 0 else 'bp-row-gain' }}">
                                            <td><span t-esc="line.name"/></td>
                                            <td class="bp-num">
                                                <span t-esc="'%.3f' % line.total"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <div class="bp-net-box">
                            <table class="bp-net-table">
                                <tr>
                                    <td class="bp-net-label">NET À PAYER</td>
                                    <td class="bp-net-amount">
                                        <t t-set="net_line" t-value="o.line_ids.filtered(lambda l: l.code == 'NET')"/>
                                        <span t-esc="'%.3f' % sum(net_line.mapped('total'))"/>
                                        <span t-esc="o.currency_id.symbol"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <p class="mt-2">
                            À verser sur le compte bancaire de
                            <i t-esc="o.employee_id.name"/> :
                            <b>
                                <span t-esc="'%.3f' % sum(net_line.mapped('total'))"/>
                                <span t-esc="o.currency_id.symbol"/>
                            </b>
                        </p>

                        <p class="bp-footer-note">
                            Document généré automatiquement - ne constitue pas
                            un justificatif fiscal officiel sans vérification
                            des taux CNSS / IRPP appliqués.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
