<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_irpp_bareme_list" model="ir.ui.view">
        <field name="name">hr.irpp.bareme.list</field>
        <field name="model">hr.irpp.bareme</field>
        <field name="arch" type="xml">
            <list string="Barème IRPP" editable="bottom">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="tranche_min"/>
                <field name="tranche_max"/>
                <field name="taux"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_hr_irpp_bareme" model="ir.actions.act_window">
        <field name="name">Barème IRPP</field>
        <field name="res_model">hr.irpp.bareme</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez les tranches du barème IRPP en vigueur
            </p>
            <p>
                Mettez à jour ces tranches chaque année selon la Loi de
                Finances applicable.
            </p>
        </field>
    </record>
</odoo>
