<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_list" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Prêts / Avances" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_demande"/>
                <field name="montant"/>
                <field name="nombre_echeances"/>
                <field name="montant_rembourse"/>
                <field name="solde_restant"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'running'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Prêt / Avance">
                <header>
                    <button name="action_validate" type="object"
                            string="Valider" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Annuler"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date_demande"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="montant"/>
                            <field name="nombre_echeances"/>
                            <field name="montant_echeance"/>
                            <field name="montant_rembourse"/>
                            <field name="solde_restant"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Motif du prêt..."/>
                    <notebook>
                        <page string="Échéancier">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="montant"/>
                                    <field name="paid"/>
                                    <field name="payslip_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">Prêts / Avances</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une nouvelle demande de prêt ou d'avance sur salaire
            </p>
        </field>
    </record>
</odoo>
