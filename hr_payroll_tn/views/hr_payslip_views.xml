<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_list_tn" model="ir.ui.view">
        <field name="name">hr.payslip.list.tn</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="departement_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_hr_payslip_form_tn" model="ir.ui.view">
        <field name="name">hr.payslip.form.tn</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="struct_id" position="after">
                <field name="categorie_pro"/>
                <field name="echelon"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="%(hr_payroll_tn.action_report_bulletin_paie_tn)d"
                        type="action" string="Bulletin de paie (TN)"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_search_tn" model="ir.ui.view">
        <field name="name">hr.payslip.search.tn</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Département" name="groupby_departement_tn"
                        context="{'group_by': 'departement_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
