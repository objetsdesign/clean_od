<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tn" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[last()]" position="after">
                <block title="Paie Tunisie" name="paie_tunisie_settings">
                    <setting string="CNSS" help="Taux de cotisation CNSS">
                        <field name="cnss_employer_number"/>
                        <div class="row mt8">
                            <label for="cnss_employee_rate" class="col-lg-6"
                                   string="Taux salarié (%)"/>
                            <field name="cnss_employee_rate" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="cnss_employer_rate" class="col-lg-6"
                                   string="Taux patronal (%)"/>
                            <field name="cnss_employer_rate" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="cnss_accident_travail_rate" class="col-lg-6"
                                   string="Taux Accident du travail (%)"/>
                            <field name="cnss_accident_travail_rate" class="col-lg-2"/>
                        </div>
                    </setting>
                    <setting string="IRPP / CSS" help="Déductions et contribution sociale">
                        <div class="row mt8">
                            <label for="irpp_deduction_chef_famille" class="col-lg-6"
                                   string="Déduction chef de famille (TND/an)"/>
                            <field name="irpp_deduction_chef_famille" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="irpp_deduction_par_enfant" class="col-lg-6"
                                   string="Déduction par enfant (TND/an)"/>
                            <field name="irpp_deduction_par_enfant" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="irpp_nb_enfants_max" class="col-lg-6"
                                   string="Nombre max. d'enfants déductibles"/>
                            <field name="irpp_nb_enfants_max" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="irpp_css_rate" class="col-lg-6"
                                   string="Taux CSS (%)"/>
                            <field name="irpp_css_rate" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="irpp_abattement_frais_pro_rate" class="col-lg-6"
                                   string="Abattement frais professionnels (%)"/>
                            <field name="irpp_abattement_frais_pro_rate" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="irpp_abattement_frais_pro_max" class="col-lg-6"
                                   string="Plafond abattement (TND/an)"/>
                            <field name="irpp_abattement_frais_pro_max" class="col-lg-2"/>
                        </div>
                        <div class="mt8">
                            <button name="%(action_hr_irpp_bareme)d" type="action"
                                    string="Configurer le barème IRPP →"
                                    class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
