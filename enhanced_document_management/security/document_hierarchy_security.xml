<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Règles GLOBALES multi-entreprise : chaque utilisateur ne voit que les
         dossiers / documents des entreprises actives dans son sélecteur
         (VONROSS, ...). Les règles globales s'ajoutent (ET) aux règles de
         groupe existantes, elles n'élargissent donc aucun accès. -->
    <record id="document_workspace_rule_company" model="ir.rule">
        <field name="name">Dossiers documentaires : multi-entreprise</field>
        <field name="model_id" ref="model_document_workspace"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="document_file_rule_company" model="ir.rule">
        <field name="name">Documents : multi-entreprise</field>
        <field name="model_id" ref="model_document_file"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
